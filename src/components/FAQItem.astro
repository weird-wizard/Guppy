---
// 全局通用高频问答组件 (FAQItem.astro)
// 用于疾病、繁殖、饲养等文章中的 FAQ 高频避坑与疑难解答

interface Props {
  q: string;
  num?: number | string;
  tag?: string;
  type?: 'warning' | 'danger' | 'tip' | 'info';
}

const {
  q,
  num,
  tag,
  type = 'tip',
} = Astro.props;

const THEMES = {
  warning: {
    qBg: 'bg-amber-100 text-amber-900 border-amber-200',
    tagBadge: 'bg-amber-50 text-amber-800 border-amber-200/80',
    border: 'border-slate-200/90',
  },
  danger: {
    qBg: 'bg-rose-100 text-rose-900 border-rose-200',
    tagBadge: 'bg-rose-50 text-rose-700 border-rose-200/80',
    border: 'border-slate-200/90',
  },
  tip: {
    qBg: 'bg-emerald-100 text-emerald-900 border-emerald-200',
    tagBadge: 'bg-emerald-50 text-emerald-800 border-emerald-200/80',
    border: 'border-slate-200/90',
  },
  info: {
    qBg: 'bg-aqua-100 text-aqua-900 border-aqua-200',
    tagBadge: 'bg-aqua-50 text-aqua-800 border-aqua-200/80',
    border: 'border-slate-200/90',
  },
};

const t = THEMES[type] ?? THEMES.tip;
---

<div class={`my-4 p-4 sm:p-5 rounded-2xl bg-white border ${t.border} shadow-2xs not-prose`}>
  {/* 问题栏 (Q) */}
  <div class="flex items-start justify-between gap-2.5 mb-2.5 pb-2.5 border-b border-slate-100">
    <div class="flex items-start gap-2.5">
      <span class={`w-6 h-6 rounded-lg ${t.qBg} font-mono font-bold text-xs grid place-items-center shrink-0 border mt-0.5 shadow-2xs`}>
        {num ? (String(num).startsWith('Q') ? num : `Q${num}`) : 'Q'}
      </span>
      <h3 class="font-bold text-slate-900 text-sm sm:text-base leading-snug m-0">
        {q}
      </h3>
    </div>
    {tag && (
      <span class={`text-[11px] px-2 py-0.5 rounded-md border font-medium shrink-0 ${t.tagBadge}`}>
        {tag}
      </span>
    )}
  </div>

  {/* 回答栏 (A) */}
  <div class="text-[14px] sm:text-[15px] text-slate-700 leading-relaxed space-y-2 ml-0 sm:ml-8.5">
    <slot />
  </div>
</div>
