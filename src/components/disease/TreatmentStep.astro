---
// 单个救治步骤卡片 (TreatmentStep.astro)
// 用于清晰展现 STEP 序号、操作标题、核心动作、重点警示

interface Props {
  step: number | string;
  title: string;
  tag?: string;
  isCrucial?: boolean;
}

const { step, title, tag, isCrucial = false } = Astro.props;
---

<div
  class:list={[
    'p-4 rounded-xl border transition-all text-xs sm:text-sm leading-relaxed',
    isCrucial
      ? 'bg-amber-50/50 border-amber-200/90 shadow-2xs'
      : 'bg-white border-slate-200/90 shadow-2xs hover:border-slate-300',
  ]}
>
  <div class="flex items-center justify-between gap-2 mb-2 pb-1.5 border-b border-slate-100">
    <div class="flex items-center gap-2">
      <span class="w-6 h-6 rounded-lg bg-slate-900 text-white font-bold font-mono text-xs grid place-items-center shrink-0">
        {step}
      </span>
      <h3 class="font-bold text-slate-900 text-sm sm:text-base m-0">
        {title}
      </h3>
    </div>
    {tag && (
      <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 font-medium">
        {tag}
      </span>
    )}
  </div>

  <div class="text-slate-700 space-y-1.5 ml-0 sm:ml-8">
    <slot />
  </div>
</div>
