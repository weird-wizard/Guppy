---
// 标准分步治疗规程容器组件 (TreatmentSteps.astro)
// 用于包裹若干个 Step 步骤卡片

interface Props {
  title?: string;
}

const { title = '标准临床救治分步 SOP' } = Astro.props;
---

<div class="my-6 space-y-3 not-prose">
  {title && (
    <div class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2 flex items-center gap-1.5">
      <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-aqua-700" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </svg>
      <span>{title}</span>
    </div>
  )}
  <div class="space-y-3">
    <slot />
  </div>
</div>
