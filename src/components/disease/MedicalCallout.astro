---
// 临床警示与高危禁忌盒组件 (MedicalCallout.astro)
// 支持 danger（高危死线）、warning（警示注意）、tip（实操锦囊）、info（科普提示）

interface Props {
  type?: 'danger' | 'warning' | 'tip' | 'info';
  title?: string;
}

const { type = 'warning', title } = Astro.props;

const THEMES = {
  danger: {
    container: 'bg-rose-50/80 border-rose-200/80 text-rose-950',
    iconBg: 'bg-rose-100 text-rose-700',
    titleColor: 'text-rose-900',
    defaultTitle: '高危禁忌 · 致命误区',
    iconPath: 'M12 9v4m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
  warning: {
    container: 'bg-amber-50/80 border-amber-200/80 text-amber-950',
    iconBg: 'bg-amber-100 text-amber-800',
    titleColor: 'text-amber-900',
    defaultTitle: '重点警示 · 用药注意',
    iconPath: 'M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z',
  },
  tip: {
    container: 'bg-emerald-50/80 border-emerald-200/80 text-emerald-950',
    iconBg: 'bg-emerald-100 text-emerald-700',
    titleColor: 'text-emerald-900',
    defaultTitle: '临床经验 · 实操锦囊',
    iconPath: 'M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
  info: {
    container: 'bg-aqua-50/80 border-aqua-200/80 text-aqua-950',
    iconBg: 'bg-aqua-100 text-aqua-700',
    titleColor: 'text-aqua-900',
    defaultTitle: '科普提示',
    iconPath: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
};

const t = THEMES[type] ?? THEMES.warning;
---

<div class={`my-5 p-4 sm:p-5 rounded-xl border ${t.container} shadow-2xs not-prose`}>
  <div class="flex items-start gap-3">
    <div class={`w-6 h-6 rounded-lg ${t.iconBg} grid place-items-center shrink-0 mt-0.5`}>
      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d={t.iconPath} />
      </svg>
    </div>
    <div class="flex-1 min-w-0 text-[14px] sm:text-[15px] leading-relaxed">
      <div class={`font-bold ${t.titleColor} text-sm sm:text-base mb-1.5 flex items-center gap-1.5`}>
        <span>{title ?? t.defaultTitle}</span>
      </div>
      <div class="text-slate-700 space-y-1.5 leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</div>
