---
// 品种图片组件：基于 Astro Assets 自动生成经过 WebP 压缩与尺寸裁剪的高性能缩略图。
// 避免加载数兆字节的原始未压缩大图，极大提升图鉴首屏加载与浏览流畅度。

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  alt: string;
  /** 渐变起始色，默认取品种主色 */
  gradientFrom?: string;
  image?: ImageMetadata | string;
  width?: number;
  height?: number;
  quality?: number | 'low' | 'mid' | 'high' | 'max';
  /** 首屏关键图：eager 加载 + 高优先级（用于详情页主图） */
  priority?: boolean;
  /** View Transitions 共享元素形变名称 */
  transitionName?: string;
  class?: string;
}

const {
  alt,
  gradientFrom = '#5cc3ff',
  image,
  width = 480,
  height = 360,
  quality = 82,
  priority = false,
  transitionName,
  class: className = ''
} = Astro.props;

// 颜色枚举 → 渐变主色映射（与 content.config.ts 的 color 字段对应）
export const COLOR_GRADIENTS: Record<string, string> = {
  red: '#f55643',
  blue: '#35a4ff',
  green: '#34d399',
  yellow: '#fbbf24',
  purple: '#a78bfa',
  white: '#e2e8f0',
  black: '#1e293b',
  snake: '#f59e0b',
  multi: 'linear-gradient(135deg, #f43f5e 0%, #fb923c 20%, #facc15 40%, #10b981 60%, #38bdf8 80%, #8b5cf6 100%)',
};

// 颜色枚举 → 卡片悬浮专属溢彩光晕颜色（半透明）
export const COLOR_GLOWS: Record<string, string> = {
  red: 'rgba(245, 86, 67, 0.28)',
  blue: 'rgba(53, 164, 255, 0.28)',
  green: 'rgba(52, 211, 153, 0.28)',
  yellow: 'rgba(251, 191, 36, 0.28)',
  purple: 'rgba(167, 139, 250, 0.28)',
  white: 'rgba(226, 232, 240, 0.35)',
  black: 'rgba(30, 41, 59, 0.3)',
  snake: 'rgba(245, 158, 11, 0.28)',
  multi: 'rgba(139, 92, 246, 0.28)',
};

const isImageMetadata = typeof image === 'object' && image !== null && 'src' in image;
---

{image ? (
  <div class:list={["relative w-full h-full overflow-hidden bg-slate-100 flex items-center justify-center", className]}>
    {isImageMetadata ? (
      <Image
        src={image as ImageMetadata}
        alt={alt}
        width={width}
        height={height}
        format="webp"
        quality={quality}
        draggable="false"
        class="w-full h-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] select-none pointer-events-none"
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
        style={transitionName ? `view-transition-name: ${transitionName};` : undefined}
      />
    ) : (
      <img
        src={typeof image === 'string' ? image : (image as any).src}
        alt={alt}
        width={width}
        height={height}
        draggable="false"
        class="w-full h-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] select-none pointer-events-none"
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
        style={transitionName ? `view-transition-name: ${transitionName};` : undefined}
      />
    )}
  </div>
) : (
  <div
    class="breed-img-placeholder aspect-[4/3] w-full h-full"
    style={`--ph-grad: linear-gradient(135deg, ${gradientFrom} 0%, color-mix(in srgb, ${gradientFrom} 35%, #0d2240 65%) 100%); ${transitionName ? `view-transition-name: ${transitionName};` : ''}`}
    role="img"
    aria-label={`${alt}（占位图）`}
  >
    <span class="ph-watermark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2.5 12c3-4.5 6.5-6.5 9.5-6.5 3.2 0 5.4 1.5 6.8 4.2l3.2-1.7v8l-3.2-1.7c-1.4 2.7-3.6 4.2-6.8 4.2-3 0-6.5-2-9.5-6.5z" />
        <circle cx="9" cy="12" r="0.6" fill="currentColor" />
      </svg>
    </span>
    <span class="ph-badge" aria-hidden="true">待补图</span>
  </div>
)}
