---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<BaseLayout title={`${guide.data.title} - 孔雀鱼百科`} description={guide.data.subtitle ?? guide.data.title}>
  <article class="max-w-3xl mx-auto px-4 py-14">
    <header class="mb-10">
      <nav aria-label="面包屑" class="text-sm text-slate-400 mb-4">
        <a href="/" class="hover:text-aqua-600">首页</a>
        <span class="mx-2">/</span>
        <a href="/guide/" class="hover:text-aqua-600">饲养指南</a>
      </nav>
      <p class="text-sm font-medium text-aqua-600 mb-2">饲养指南</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">{guide.data.title}</h1>
      {guide.data.subtitle && <p class="mt-4 text-lg text-slate-600">{guide.data.subtitle}</p>}
      <div class="mt-5 flex items-center gap-3 text-sm text-slate-400">
        <span>更新于 {guide.data.pubDate.toLocaleDateString('zh-CN')}</span>
        {guide.data.tags?.map((tag) => (
          <span class="px-2.5 py-0.5 rounded-full bg-aqua-50 text-aqua-700">{tag}</span>
        ))}
      </div>
    </header>

    <div class="prose-guppy">
      <Content />
    </div>
  </article>
</BaseLayout>
