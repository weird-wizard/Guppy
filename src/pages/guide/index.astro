---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  Compass,
  Droplets,
  Box,
  Utensils,
  Users,
  Wrench,
  ArrowRight,
} from 'lucide-astro';

const allGuides = (await getCollection('guides')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// 6 个阶梯式饲养进阶步骤
const STAGES = [
  {
    id: '01-beginner',
    stepNum: '01',
    stageLabel: '开缸与养水',
    keyPoints: ['开缸清洁消毒', '硝化系统建立周期', '过温过水标准SOP', '新鱼检疫防团灭'],
    icon: Compass,
  },
  {
    id: '02-water-quality',
    stepNum: '02',
    stageLabel: '水质与环境',
    keyPoints: ['恒温24-26℃控制', '弱碱pH7.0-7.5稳水', '氮循环毒素控制', '科学换水防震荡'],
    icon: Droplets,
  },
  {
    id: '03-tank-setup',
    stepNum: '03',
    stageLabel: '鱼缸与造景',
    keyPoints: ['40cm+鱼缸选型', '水妖精与瀑布过滤', '防爆加热棒安装', '低光耐阴水草搭配'],
    icon: Box,
  },
  {
    id: '04-feeding',
    stepNum: '04',
    stageLabel: '营养与投喂',
    keyPoints: ['全周期投喂计划', '鲜活丰年虾孵化', '人工饲料配比', '2-3分钟吃光法则'],
    icon: Utensils,
  },
  {
    id: '05-tankmates',
    stepNum: '05',
    stageLabel: '社区与混养',
    keyPoints: ['混养三大黄金准则', '灯鱼鼠鱼黄金搭档', '虎皮斗鱼绝对禁忌', '被啄尾应急抢救'],
    icon: Users,
  },
  {
    id: '06-maintenance',
    stepNum: '06',
    stageLabel: '日常与维保',
    keyPoints: ['日周月维护清单', '滤棉清洗三禁忌', '长期水质老败排查', '死鱼应急处理SOP'],
    icon: Wrench,
  },
];

const roadmapItems = STAGES.map((stg) => {
  const guide = allGuides.find((g) => g.id === stg.id);
  return {
    ...stg,
    guide,
  };
});
---

<BaseLayout
  title="饲养指南 - 孔雀鱼百科"
  description="孔雀鱼饲养全周期实操指南：从零开缸养水、水质管理、鱼缸造景、科学投喂、社区混养到日常维保的6步阶梯手册。"
>
  <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-8">
    <!-- ───────────────────────────────────────────── -->
    <!-- 顶部标题区 (Apple-style Editorial Header)      -->
    <!-- ───────────────────────────────────────────── -->
    <header class="mb-6 sm:mb-8 pb-4 border-b border-slate-200/80 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <nav aria-label="面包屑" class="text-xs text-slate-400 mb-1.5 flex items-center gap-1.5">
          <a href="/" class="hover:text-slate-900 transition-colors">首页</a>
          <span class="text-slate-300">/</span>
          <span class="text-slate-600 font-medium">饲养指南</span>
        </nav>
        <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold tracking-tight text-slate-900">
          孔雀鱼进阶饲养指南
        </h1>
        <p class="mt-1 text-xs sm:text-sm text-slate-500">
          从开缸养水到日常维保，循序渐进掌握养好孔雀鱼的核心实战方法
        </p>
      </div>

      <div class="flex items-center gap-2 text-xs shrink-0">
        <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 font-medium border border-slate-200/80 flex items-center gap-1.5 shadow-2xs">
          <span>全套收录</span>
          <strong class="text-aqua-700 font-bold">6 篇核心手册</strong>
        </span>
      </div>
    </header>

    <!-- ───────────────────────────────────────────── -->
    <!-- 6 步阶梯成长路线 (Stepped Editorial Cards)     -->
    <!-- ───────────────────────────────────────────── -->
    <section class="relative space-y-4 sm:space-y-5">
      {/* 贯通背景中轴连线 */}
      <div
        aria-hidden="true"
        class="absolute left-4.5 sm:left-5.5 top-8 bottom-8 w-px -translate-x-1/2 bg-slate-200"
      ></div>

      {roadmapItems.map((item) => {
        const Icon = item.icon;
        const gd = item.guide;
        if (!gd) return null;

        return (
          <div class="relative flex items-start gap-3.5 sm:gap-5 group">
            {/* 左侧步骤序号圆标 */}
            <div class="shrink-0 w-9 sm:w-11 flex justify-center z-10 pt-4">
              <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border-2 border-slate-300 group-hover:border-aqua-600 group-hover:text-aqua-600 text-slate-700 flex items-center justify-center font-mono font-bold text-xs sm:text-sm shadow-2xs shrink-0 ring-4 ring-slate-50 transition-all duration-300">
                {item.stepNum}
              </div>
            </div>

            {/* 右侧卡片主体 */}
            <a
              href={`/guide/${gd.id}/`}
              class="flex-1 bg-white rounded-2xl border border-slate-200/90 p-4.5 sm:p-5 shadow-2xs hover:shadow-card hover:border-aqua-400 hover:-translate-y-0.5 active:bg-slate-50 transition-all duration-300 flex flex-col justify-between gap-3"
            >
              <div>
                {/* 卡片顶栏 */}
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span class="text-xs font-bold text-aqua-700 flex items-center gap-1.5">
                    <Icon class="w-3.5 h-3.5 shrink-0" />
                    <span>步骤 {item.stepNum} · {item.stageLabel}</span>
                  </span>

                  <span class="text-xs font-semibold text-slate-400 group-hover:text-aqua-700 flex items-center gap-1 transition-colors">
                    <span class="hidden sm:inline">阅读指南</span>
                    <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200" />
                  </span>
                </div>

                {/* 标题 */}
                <h2 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-aqua-700 transition-colors leading-snug">
                  {gd.data.title}
                </h2>

                {/* 导读 */}
                {gd.data.subtitle && (
                  <p class="mt-1 text-xs sm:text-sm text-slate-600 leading-relaxed">
                    {gd.data.subtitle}
                  </p>
                )}
              </div>

              {/* 核心要点药丸条 */}
              {item.keyPoints && item.keyPoints.length > 0 && (
                <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center gap-1.5">
                  {item.keyPoints.map((pt) => (
                    <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-md bg-slate-50 text-slate-600 border border-slate-200/60">
                      {pt}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </div>
        );
      })}
    </section>
  </div>
</BaseLayout>
