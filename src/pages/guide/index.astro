---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// 阶段定义映射
const STAGE_LABELS = [
  '第一阶段 · 筑基准备',
  '第二阶段 · 水质平衡',
  '第三阶段 · 生态造景',
  '第四阶段 · 营养喂饲',
  '第五阶段 · 社区混养',
  '第六阶段 · 长期维护',
];
---

<BaseLayout title="饲养指南 - 孔雀鱼百科" description="孔雀鱼饲养指南：新手入门、水质管理、饲料喂养、鱼缸设置、混养搭配、日常维护">
  {/* 深蓝页头带 */}
  <section class="relative bg-gradient-to-b from-abyss-950 via-abyss-900 to-abyss-800 text-white">
    <div class="max-w-6xl mx-auto px-4 pt-14 pb-14">
      <p class="eyebrow mb-2">GUIDE · 进阶路线</p>
      <h1 class="text-3xl sm:text-4xl font-bold">养好孔雀鱼的成长路线图</h1>
      <p class="mt-3 text-aqua-100/80 max-w-2xl">从开缸养水到日常维护，遵循 6 步阶梯式成长路径，轻松打造健康繁盛的水族箱生态。</p>
    </div>
    {/* 波浪分隔 */}
    <div aria-hidden="true" class="h-10 w-full overflow-hidden leading-none text-slate-50">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none" class="block h-full w-full">
        <path fill="currentColor" d="M0 40V26c240 22 480-20 720 0s480 22 720 0v14z" />
      </svg>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12">
    <!-- 时间轴路线图容器 -->
    <div class="relative pl-6 sm:pl-10 border-l-2 border-aqua-200/80 space-y-8 my-4">
      {guides.map((guide, i) => (
        <div class="relative group">
          {/* 时间轴发光节点 */}
          <div
            aria-hidden="true"
            class="absolute -left-[31px] sm:-left-[47px] top-6 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white border-2 border-aqua-500 shadow-md shadow-aqua-500/20 grid place-items-center text-aqua-700 font-bold text-xs sm:text-sm group-hover:scale-110 group-hover:bg-aqua-500 group-hover:text-white transition-all duration-300 ease-[var(--ease-spring)] z-10"
          >
            {String(i + 1).padStart(2, '0')}
          </div>

          <!-- 卡片本体 -->
          <a
            href={`/guide/${guide.id}/`}
            class="block glass-card rounded-2xl border border-slate-200/90 shadow-card hover:shadow-card-hover hover:border-aqua-400 hover:-translate-y-1 transition-all duration-300 p-6 sm:p-7 relative overflow-hidden"
          >
            {/* 阶段眉题 */}
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-semibold tracking-wider text-aqua-600 uppercase bg-aqua-50/80 px-2.5 py-1 rounded-md border border-aqua-100/60">
                {STAGE_LABELS[i] ?? `第 ${i + 1} 步`}
              </span>
              <span class="text-xs text-slate-400">
                {guide.data.pubDate.toLocaleDateString('zh-CN')}
              </span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-aqua-700 transition-colors flex items-center justify-between">
              <span>{guide.data.title}</span>
              <span class="text-slate-300 group-hover:text-aqua-600 group-hover:translate-x-1 transition-all text-lg" aria-hidden="true">→</span>
            </h2>

            {guide.data.subtitle && (
              <p class="mt-2.5 text-slate-600 text-sm sm:text-base leading-relaxed">
                {guide.data.subtitle}
              </p>
            )}

            {guide.data.tags && guide.data.tags.length > 0 && (
              <div class="mt-4 pt-3 border-t border-slate-100/80 flex flex-wrap gap-2">
                {guide.data.tags.map((tag) => (
                  <span class="px-2.5 py-0.5 rounded-full bg-slate-100/80 text-slate-600 text-xs">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
