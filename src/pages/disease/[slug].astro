---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import {
  ArrowLeft,
  Calculator,
  ShieldCheck,
  Clock,
  List,
} from '@lucide/astro';

export async function getStaticPaths() {
  const articles = await getCollection('disease');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

// 提取本篇二级章节作为目录
const toc = headings.filter((h) => h.depth === 2);

// 提取对应章节的精确 slug 锚点（解决手动拼写与特殊符号不匹配导致不跳转的问题）
const pathogenSlug = headings.find((h) => h.text.includes('病原') || h.text.includes('机理'))?.slug ?? (toc[0]?.slug ?? '一病原与致病机理');
const symptomSlug = headings.find((h) => h.text.includes('症状') || h.text.includes('鉴别'))?.slug ?? (toc[1]?.slug ?? '二症状识别与精准鉴别');
const treatmentSlug = headings.find((h) => h.text.includes('救治') || h.text.includes('治疗') || h.text.includes('规程'))?.slug ?? (toc[2]?.slug ?? '三标准临床四步救治规程');
const isolationSlug = headings.find((h) => h.text.includes('隔离') || h.text.includes('环境') || h.text.toLowerCase().includes('step 1') || h.text.includes('物理隔离'))?.slug ?? treatmentSlug;

const SEVERITY_CONFIG: Record<string, {
  label: string;
  dotClass: string;
  badgeClass: string;
}> = {
  critical: {
    label: '极度危险 · 需隔离',
    dotClass: 'bg-rose-500',
    badgeClass: 'bg-rose-50/80 text-rose-700 border-rose-200/80',
  },
  warning: {
    label: '重点治疗 · 需对症',
    dotClass: 'bg-amber-500',
    badgeClass: 'bg-amber-50/80 text-amber-800 border-amber-200/80',
  },
  mild: {
    label: '轻度调水 · 可自愈',
    dotClass: 'bg-emerald-500',
    badgeClass: 'bg-emerald-50/80 text-emerald-800 border-emerald-200/80',
  },
  guide: {
    label: '综合指南',
    dotClass: 'bg-aqua-500',
    badgeClass: 'bg-aqua-50/80 text-aqua-800 border-aqua-200/80',
  },
};

const PATHOGEN_TYPE_LABELS: Record<string, string> = {
  parasite: '外/内寄生虫',
  bacteria: '细菌感染',
  fungus: '真菌性/水霉',
  water: '水质/环境应激',
  mixed: '综合病因',
};

const sev = SEVERITY_CONFIG[article.data.severity] ?? SEVERITY_CONFIG.warning;
const isGuide = article.data.severity === 'guide';
---

<BaseLayout title={`${article.data.title} - 孔雀鱼百科`} description={article.data.subtitle ?? article.data.title}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-9">
    <!-- 响应式双栏布局：左侧贴附导航 + 主体文章居中 -->
    <div class="lg:flex lg:gap-10 items-start">
      <!-- ───────────────────────────────────────────── -->
      <!-- 左侧贴附目录导航 (Sticky TOC on Left)          -->
      <!-- ───────────────────────────────────────────── -->
      {toc.length > 0 && (
        <aside class="hidden lg:block lg:w-56 lg:shrink-0 lg:sticky lg:top-20 space-y-3">
          <!-- 返回链接 -->
          <a
            href="/disease/"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors w-full"
          >
            <ArrowLeft class="w-3.5 h-3.5" />
            <span>返回疾病防治列表</span>
          </a>

          <!-- 本篇章节导航面板 -->
          <div class="p-3.5 rounded-xl bg-white border border-slate-200/90 shadow-2xs space-y-2.5">
            <div class="text-[11px] font-bold text-slate-900 uppercase tracking-wider flex items-center gap-1.5 pb-2 border-b border-slate-100">
              <List class="w-3.5 h-3.5 text-aqua-700" />
              <span>本篇章节导航</span>
            </div>
            <nav class="space-y-1 text-xs">
              {toc.map((item) => (
                <a
                  href={`#${item.slug}`}
                  class="block py-1 px-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-colors leading-snug truncate"
                  title={item.text}
                >
                  {item.text}
                </a>
              ))}
            </nav>

            <a
              href="/disease/#calculator"
              class="pt-2.5 border-t border-slate-100 block text-[11px] font-semibold text-aqua-800 hover:text-aqua-900 transition-colors"
            >
              打开用药安全计算器 →
            </a>
          </div>
        </aside>
      )}

      <!-- ───────────────────────────────────────────── -->
      <!-- 中间主体内容区（在屏幕主体空间居中展开）          -->
      <!-- ───────────────────────────────────────────── -->
      <main class="flex-1 max-w-3xl mx-auto min-w-0">
        <!-- 移动端顶部导航与面包屑 -->
        <header class="mb-6 sm:mb-8">
          <nav aria-label="面包屑" class="text-[11px] sm:text-xs text-slate-400 mb-3 flex items-center gap-1.5 flex-wrap">
            <a href="/" class="hover:text-slate-900 transition-colors">首页</a>
            <span class="text-slate-300">/</span>
            <a href="/disease/" class="hover:text-slate-900 transition-colors">疾病防治</a>
            <span class="text-slate-300">/</span>
            <span class="text-slate-600 font-medium">{article.data.title}</span>
          </nav>

          <!-- 状态与隔离徽章 -->
          <div class="flex items-center gap-2 mb-2">
            <span class={`inline-flex items-center gap-1.5 text-xs px-2.5 py-0.5 rounded-full border font-medium ${sev.badgeClass}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${sev.dotClass}`}></span>
              {sev.label}
            </span>
            {article.data.isolationRequired ? (
              <span class="text-xs font-semibold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200/60">
                须隔离治疗
              </span>
            ) : (
              <span class="text-xs text-slate-400 font-medium">
                视情隔离
              </span>
            )}
          </div>

          <h1 class="text-xl sm:text-3xl font-bold text-slate-900 tracking-tight leading-tight">
            {article.data.title}
          </h1>
          {article.data.subtitle && (
            <p class="mt-2 text-sm sm:text-base text-slate-600 leading-relaxed">
              {article.data.subtitle}
            </p>
          )}

          <!-- 诊疗与急救要点速查卡片 (Apple / Notion 简约工作卡) -->
          {!isGuide && (
            <div class="mt-4 sm:mt-5 rounded-xl border border-slate-200/90 bg-white p-4 sm:p-5 shadow-2xs">
              <div class="flex items-center justify-between gap-2 pb-2.5 mb-3 border-b border-slate-100">
                <span class="text-xs font-bold text-slate-900 uppercase tracking-wider inline-flex items-center gap-1.5">
                  <ShieldCheck class="w-3.5 h-3.5 text-aqua-700" />
                  <span>诊疗与急救要点速查</span>
                </span>
                <a
                  href="/disease/#calculator"
                  class="text-xs font-semibold text-aqua-700 hover:text-aqua-900 inline-flex items-center gap-1 transition-colors"
                >
                  <Calculator class="w-3.5 h-3.5" />
                  <span>用药剂量计算器 →</span>
                </a>
              </div>

              <!-- 4 大参数卡片（支持点击跳转到对应章节） -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-2.5 text-xs mb-3">
                <a
                  href={`#${pathogenSlug}`}
                  class="group p-2.5 rounded-lg border border-slate-200/70 bg-slate-50/70 hover:bg-white hover:border-aqua-300 hover:shadow-2xs active:scale-95 transition-all flex flex-col justify-between"
                  title="点击查看病原体与致病机理"
                >
                  <div>
                    <span class="text-[10px] text-slate-400 block mb-0.5 group-hover:text-aqua-700 transition-colors">病原分类</span>
                    <span class="font-bold text-slate-900 leading-tight block">
                      {PATHOGEN_TYPE_LABELS[article.data.pathogenType ?? 'mixed'] ?? '其他'}
                    </span>
                  </div>
                  <span class="text-[10px] text-slate-400 group-hover:text-aqua-700 mt-1.5 inline-flex items-center gap-0.5">
                    机理详情 <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a
                  href={`#${isolationSlug}`}
                  class="group p-2.5 rounded-lg border border-slate-200/70 bg-slate-50/70 hover:bg-white hover:border-aqua-300 hover:shadow-2xs active:scale-95 transition-all flex flex-col justify-between"
                  title="点击查看隔离与水体设置要求"
                >
                  <div>
                    <span class="text-[10px] text-slate-400 block mb-0.5 group-hover:text-aqua-700 transition-colors">治疗环境</span>
                    <span class="font-bold text-slate-900 leading-tight block">
                      {article.data.isolationRequired ? '独立裸缸 (禁原缸)' : '原缸/独立缸'}
                    </span>
                  </div>
                  <span class="text-[10px] text-slate-400 group-hover:text-aqua-700 mt-1.5 inline-flex items-center gap-0.5">
                    隔离规范 <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a
                  href={`#${symptomSlug}`}
                  class="group p-2.5 rounded-lg border border-slate-200/70 bg-slate-50/70 hover:bg-white hover:border-aqua-300 hover:shadow-2xs active:scale-95 transition-all flex flex-col justify-between"
                  title="点击查看症状识别与鉴别诊断"
                >
                  <div>
                    <span class="text-[10px] text-slate-400 block mb-0.5 group-hover:text-aqua-700 transition-colors">常见诱因</span>
                    <span class="font-bold text-slate-900 leading-tight block">
                      {article.data.pathogenType === 'fungus' ? '外伤 / 低温' : article.data.pathogenType === 'parasite' ? '未检疫 / 活饵' : '水质恶化 / 温差'}
                    </span>
                  </div>
                  <span class="text-[10px] text-slate-400 group-hover:text-aqua-700 mt-1.5 inline-flex items-center gap-0.5">
                    鉴别诊断 <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a
                  href={`#${treatmentSlug}`}
                  class="group p-2.5 rounded-lg border border-slate-200/70 bg-slate-50/70 hover:bg-white hover:border-aqua-300 hover:shadow-2xs active:scale-95 transition-all flex flex-col justify-between"
                  title="点击查看标准治疗实操步骤"
                >
                  <div>
                    <span class="text-[10px] text-slate-400 block mb-0.5 group-hover:text-aqua-700 transition-colors">核心操作</span>
                    <span class="font-bold text-slate-900 leading-tight block">
                      {article.data.isolationRequired ? '持续打氧+停活性炭' : '水质维护'}
                    </span>
                  </div>
                  <span class="text-[10px] text-slate-400 group-hover:text-aqua-700 mt-1.5 inline-flex items-center gap-0.5">
                    分步治疗 <span aria-hidden="true">→</span>
                  </span>
                </a>
              </div>

              <!-- 推荐治疗方案与跳转入口 -->
              <div class="bg-slate-50/80 p-3 rounded-lg border border-slate-200/60 text-xs space-y-2">
                <div class="leading-relaxed">
                  <span class="font-bold text-slate-900">核心治疗方法：</span>
                  <span class="text-slate-700">{article.data.emergencyAction ?? '隔离打氧，维持水质稳定，对症药浴'}</span>
                </div>
                <div class="pt-2 border-t border-slate-200/50 flex items-center justify-between text-[11px]">
                  <span class="text-slate-500">遵循完整疗程与巩固期，切勿提前停药</span>
                  <a
                    href={`#${treatmentSlug}`}
                    class="font-bold text-aqua-700 hover:text-aqua-900 inline-flex items-center gap-0.5 transition-colors"
                  >
                    查看分步临床治疗规程 ↓
                  </a>
                </div>
              </div>
            </div>
          )}

          <!-- 更新时间与标签 -->
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400 pt-2">
            <span class="inline-flex items-center gap-1.5">
              <Clock class="w-3 h-3" />
              <span>更新日期：{article.data.pubDate.toLocaleDateString('zh-CN')}</span>
            </span>
            <div class="flex flex-wrap items-center gap-1">
              {article.data.tags?.map((tag) => (
                <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 font-medium">#{tag}</span>
              ))}
            </div>
          </div>
        </header>

        <!-- 移动端可折叠目录速览 -->
        {toc.length > 0 && (
          <details class="lg:hidden mb-6 p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 text-xs">
            <summary class="font-bold text-slate-800 cursor-pointer flex items-center justify-between select-none">
              <span class="inline-flex items-center gap-1.5">
                <List class="w-3.5 h-3.5 text-aqua-700" />
                <span>快速浏览本篇章节目录 ({toc.length})</span>
              </span>
              <span class="text-slate-400 font-normal">展开 ↓</span>
            </summary>
            <nav class="mt-3 pt-2.5 border-t border-slate-200/60 space-y-1.5">
              {toc.map((item) => (
                <a
                  href={`#${item.slug}`}
                  class="block py-1 px-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100/80 transition-colors"
                >
                  {item.text}
                </a>
              ))}
            </nav>
          </details>
        )}

        <!-- 正文内容区 -->
        <article class="prose-guppy max-w-none">
          <Content />
        </article>

        <!-- 底部返回与工具导航（移动端全宽自适应） -->
        <footer class="mt-10 sm:mt-14 pt-6 sm:pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
          <a
            href="/disease/"
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-semibold transition-colors"
          >
            <ArrowLeft class="w-3.5 h-3.5" />
            <span>返回疾病防治首页</span>
          </a>

          <a
            href="/disease/#calculator"
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-semibold shadow-xs transition-colors"
          >
            <Calculator class="w-3.5 h-3.5" />
            <span>打开用药计算器</span>
          </a>
        </footer>
      </main>
    </div>
  </div>
</BaseLayout>
