---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import {
  ArrowLeft,
  ArrowRight,
  Calculator,
  ShieldCheck,
  AlertCircle,
  Clock,
  Sparkles,
} from '@lucide/astro';

export async function getStaticPaths() {
  const articles = await getCollection('disease');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const SEVERITY_CONFIG: Record<string, {
  label: string;
  dotClass: string;
  badgeClass: string;
}> = {
  critical: {
    label: '极度危险 · 需隔离',
    dotClass: 'bg-rose-500',
    badgeClass: 'bg-rose-50/80 text-rose-700 border-rose-200/80',
  },
  warning: {
    label: '重点治疗 · 需对症',
    dotClass: 'bg-amber-500',
    badgeClass: 'bg-amber-50/80 text-amber-800 border-amber-200/80',
  },
  mild: {
    label: '轻度调水 · 可自愈',
    dotClass: 'bg-emerald-500',
    badgeClass: 'bg-emerald-50/80 text-emerald-800 border-emerald-200/80',
  },
  guide: {
    label: '综合指南',
    dotClass: 'bg-aqua-500',
    badgeClass: 'bg-aqua-50/80 text-aqua-800 border-aqua-200/80',
  },
};

const PATHOGEN_TYPE_LABELS: Record<string, string> = {
  parasite: '外/内寄生虫',
  bacteria: '细菌感染',
  fungus: '真菌性/水霉',
  water: '水质/环境应激',
  mixed: '综合病因',
};

const sev = SEVERITY_CONFIG[article.data.severity] ?? SEVERITY_CONFIG.warning;
const isGuide = article.data.severity === 'guide';
---

<BaseLayout title={`${article.data.title} - 孔雀鱼百科`} description={article.data.subtitle ?? article.data.title}>
  <article class="max-w-3xl mx-auto px-4 py-8 sm:py-14">
    <!-- 面包屑与顶部导航 -->
    <header class="mb-8 sm:mb-10">
      <nav aria-label="面包屑" class="text-[11px] sm:text-xs text-slate-400 mb-3 sm:mb-4 flex items-center gap-1.5 flex-wrap">
        <a href="/" class="hover:text-slate-900 transition-colors">首页</a>
        <span class="text-slate-300">/</span>
        <a href="/disease/" class="hover:text-slate-900 transition-colors">疾病防治</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-600 font-medium">{article.data.title}</span>
      </nav>

      <!-- 状态与隔离徽章 -->
      <div class="flex items-center gap-2 mb-2.5">
        <span class={`inline-flex items-center gap-1.5 text-xs px-2.5 py-0.5 rounded-full border font-medium ${sev.badgeClass}`}>
          <span class={`w-1.5 h-1.5 rounded-full ${sev.dotClass}`}></span>
          {sev.label}
        </span>
        {article.data.isolationRequired ? (
          <span class="text-xs font-semibold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200/60">
            须隔离治疗
          </span>
        ) : (
          <span class="text-xs text-slate-400 font-medium">
            视情隔离
          </span>
        )}
      </div>

      <h1 class="text-xl sm:text-3xl font-bold text-slate-900 tracking-tight leading-tight">
        {article.data.title}
      </h1>
      {article.data.subtitle && (
        <p class="mt-2.5 text-sm sm:text-base text-slate-600 leading-relaxed">
          {article.data.subtitle}
        </p>
      )}

      <!-- 诊疗与急救要点速查卡片 (Apple / Notion 简约工作卡) -->
      {!isGuide && (
        <div class="mt-5 sm:mt-6 rounded-xl sm:rounded-2xl border border-slate-200/90 bg-white p-4 sm:p-5 shadow-xs">
          <div class="flex items-center justify-between gap-2 pb-2.5 mb-3 border-b border-slate-100">
            <span class="text-xs font-bold text-slate-900 uppercase tracking-wider inline-flex items-center gap-1.5">
              <ShieldCheck class="w-3.5 h-3.5 text-aqua-700" />
              <span>诊疗与急救要点速查</span>
            </span>
            <a
              href="/disease/#calculator"
              class="text-xs font-semibold text-slate-600 hover:text-slate-900 inline-flex items-center gap-1 transition-colors"
            >
              <Calculator class="w-3.5 h-3.5" />
              <span>用药计算器 →</span>
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 text-xs mb-3">
            <div class="bg-slate-50/80 p-2.5 rounded-lg border border-slate-200/60">
              <span class="text-[10px] sm:text-xs text-slate-400 block mb-0.5">病原分类</span>
              <span class="font-bold text-slate-900">
                {PATHOGEN_TYPE_LABELS[article.data.pathogenType ?? 'mixed'] ?? '其他'}
              </span>
            </div>
            <div class="bg-slate-50/80 p-2.5 rounded-lg border border-slate-200/60">
              <span class="text-[10px] sm:text-xs text-slate-400 block mb-0.5">治疗环境</span>
              <span class="font-bold text-slate-900">
                {article.data.isolationRequired ? '独立裸缸 (禁原缸)' : '原缸/独立缸'}
              </span>
            </div>
            <div class="bg-slate-50/80 p-2.5 rounded-lg border border-slate-200/60">
              <span class="text-[10px] sm:text-xs text-slate-400 block mb-0.5">常见诱因</span>
              <span class="font-bold text-slate-900">
                {article.data.pathogenType === 'fungus' ? '外伤 / 低温' : article.data.pathogenType === 'parasite' ? '未检疫 / 活饵' : '水质恶化 / 温差'}
              </span>
            </div>
            <div class="bg-slate-50/80 p-2.5 rounded-lg border border-slate-200/60">
              <span class="text-[10px] sm:text-xs text-slate-400 block mb-0.5">核心操作</span>
              <span class="font-bold text-slate-900">
                {article.data.isolationRequired ? '持续打氧+停活性炭' : '水质维护'}
              </span>
            </div>
          </div>

          {article.data.emergencyAction && (
            <div class="bg-slate-50/80 p-3 rounded-lg border border-slate-200/60 text-xs leading-relaxed">
              <span class="font-bold text-slate-900">首要处置动作：</span>
              <span class="text-slate-700">{article.data.emergencyAction}</span>
            </div>
          )}
        </div>
      )}

      <!-- 更新时间与标签 -->
      <div class="mt-3.5 flex flex-wrap items-center justify-between gap-2.5 text-[11px] text-slate-400 pt-2.5">
        <span class="inline-flex items-center gap-1.5">
          <Clock class="w-3 h-3" />
          <span>更新日期：{article.data.pubDate.toLocaleDateString('zh-CN')}</span>
        </span>
        <div class="flex flex-wrap items-center gap-1">
          {article.data.tags?.map((tag) => (
            <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 font-medium">#{tag}</span>
          ))}
        </div>
      </div>
    </header>

    <!-- 正文内容区 -->
    <div class="prose-guppy max-w-none">
      <Content />
    </div>

    <!-- 底部返回与工具导航（移动端全宽自适应） -->
    <footer class="mt-10 sm:mt-14 pt-6 sm:pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
      <a
        href="/disease/"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-semibold transition-colors"
      >
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>返回疾病防治首页</span>
      </a>

      <a
        href="/disease/#calculator"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-semibold shadow-xs transition-colors"
      >
        <Calculator class="w-3.5 h-3.5" />
        <span>打开用药计算器</span>
      </a>
    </footer>
  </article>
</BaseLayout>
