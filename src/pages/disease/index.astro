---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  Stethoscope,
  ShieldAlert,
  Calculator,
  BriefcaseMedical,
  ArrowRight,
  ArrowDown,
  Wind,
  Thermometer,
  ShieldCheck,
  Check,
  X,
  Droplets,
  FlaskConical,
  Pill,
  Box,
  Copy,
  Sliders,
  Hash,
} from '@lucide/astro';

const articles = (await getCollection('disease')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

// 发病部位定义
const BODY_PARTS = [
  { key: 'all', label: '全部部位' },
  { key: 'body', label: '体表与鳞片' },
  { key: 'fin', label: '尾鳍与胸鳍' },
  { key: 'belly', label: '腹部与消化' },
  { key: 'eye', label: '眼部异常' },
  { key: 'behavior', label: '行为异常' },
];

// 严重程度状态微标（Apple / Notion 极简克制风）
const SEVERITY_CONFIG: Record<string, { label: string; dotClass: string }> = {
  critical: {
    label: '极度危险',
    dotClass: 'bg-rose-500',
  },
  warning: {
    label: '重点治疗',
    dotClass: 'bg-amber-500',
  },
  mild: {
    label: '轻度调水',
    dotClass: 'bg-emerald-500',
  },
  guide: {
    label: '综合指南',
    dotClass: 'bg-aqua-500',
  },
};

// 病原体分类标签
const PATHOGEN_TYPE_LABELS: Record<string, string> = {
  parasite: '寄生虫感染',
  bacteria: '细菌性感染',
  fungus: '真菌/水霉',
  water: '环境/水质应激',
  mixed: '综合病症',
};
---

<BaseLayout
  title="疾病防治 - 孔雀鱼百科"
  description="孔雀鱼疾病防治：常见病对症排查、黄金急救三步法、老三样实战准则与鱼缸用药用盐剂量计算器。"
>
  <!-- ─────────────────────────────────────────────── -->
  <!-- 移动端优先与全端自适应的高质感数字工作台           -->
  <!-- ─────────────────────────────────────────────── -->
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-5 sm:py-9">
    <!-- 纯粹克制的顶部标题区 -->
    <header class="mb-5 sm:mb-6 pb-3 sm:pb-4 border-b border-slate-200/80 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5 sm:gap-2">
      <div>
        <nav aria-label="面包屑" class="text-[11px] text-slate-400 mb-1 flex items-center gap-1.5">
          <a href="/" class="hover:text-slate-900 transition-colors">首页</a>
          <span class="text-slate-300">/</span>
          <span class="text-slate-600 font-medium">疾病防治</span>
        </nav>
        <h1 class="text-lg sm:text-2xl font-bold tracking-tight text-slate-900">
          疾病防治与应急指南
        </h1>
      </div>
      <p class="text-xs text-slate-500">
        对症速查 · 急救处置 · 水体用药安全计算
      </p>
    </header>

    <!-- 响应式布局：移动端 2x2 快捷网格 / 桌面端左侧贴附导航 -->
    <div class="lg:flex lg:gap-8 items-start">
      <!-- ───────────────────────────────────────────── -->
      <!-- 导航栏：移动端 2x2 网格，桌面端垂直侧栏          -->
      <!-- ───────────────────────────────────────────── -->
      <aside class="lg:w-52 lg:shrink-0 mb-5 lg:mb-0 lg:sticky lg:top-20">
        <nav aria-label="疾病防治功能导航" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-1 gap-1.5">
          <button
            type="button"
            data-tab="triage"
            data-active="true"
            class="tab-btn w-full text-left px-2.5 sm:px-3 py-2 rounded-xl text-xs font-semibold transition-colors cursor-pointer flex items-center justify-between"
          >
            <span class="inline-flex items-center gap-1.5 sm:gap-2 truncate">
              <Stethoscope class="w-3.5 h-3.5 shrink-0 opacity-85" />
              <span class="truncate">对症排查</span>
            </span>
            <span class="text-[10px] sm:text-[11px] font-normal opacity-70 ml-1 shrink-0">
              {articles.length}
            </span>
          </button>

          <button
            type="button"
            data-tab="emergency"
            data-active="false"
            class="tab-btn w-full text-left px-2.5 sm:px-3 py-2 rounded-xl text-xs font-medium transition-colors cursor-pointer flex items-center justify-between"
          >
            <span class="inline-flex items-center gap-1.5 sm:gap-2 truncate">
              <ShieldAlert class="w-3.5 h-3.5 shrink-0 opacity-75" />
              <span class="truncate">急救与「老三样」</span>
            </span>
          </button>

          <button
            type="button"
            data-tab="calculator"
            data-active="false"
            class="tab-btn w-full text-left px-2.5 sm:px-3 py-2 rounded-xl text-xs font-medium transition-colors cursor-pointer flex items-center justify-between"
          >
            <span class="inline-flex items-center gap-1.5 sm:gap-2 truncate">
              <Calculator class="w-3.5 h-3.5 shrink-0 opacity-75" />
              <span class="truncate">用药计算器</span>
            </span>
          </button>

          <button
            type="button"
            data-tab="cabinet"
            data-active="false"
            class="tab-btn w-full text-left px-2.5 sm:px-3 py-2 rounded-xl text-xs font-medium transition-colors cursor-pointer flex items-center justify-between"
          >
            <span class="inline-flex items-center gap-1.5 sm:gap-2 truncate">
              <BriefcaseMedical class="w-3.5 h-3.5 shrink-0 opacity-75" />
              <span class="truncate">常备药箱</span>
            </span>
          </button>
        </nav>
      </aside>

      <!-- ───────────────────────────────────────────── -->
      <!-- 右侧主内容展示区                                 -->
      <!-- ───────────────────────────────────────────── -->
      <main class="flex-1 min-w-0">
        <!-- TAB 1: 对症排查 (Triage) -->
        <div id="tab-panel-triage" class="tab-panel space-y-4 sm:space-y-5">
          <!-- 部位筛选：支持移动端横向丝滑滑动的胶囊栏 -->
          <div class="flex items-center gap-1.5 pb-1 overflow-x-auto no-scrollbar -mx-3.5 px-3.5 sm:mx-0 sm:px-0 sm:flex-wrap">
            <span class="text-[11px] font-medium text-slate-400 mr-1 shrink-0">部位筛选：</span>
            <div class="flex items-center gap-1.5 shrink-0 sm:shrink sm:flex-wrap" id="body-part-filters">
              {BODY_PARTS.map((part) => (
                <button
                  type="button"
                  data-filter="bodyPart"
                  data-value={part.key}
                  data-active={part.key === 'all' ? 'true' : 'false'}
                  class="part-pill whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-medium border transition-colors cursor-pointer shrink-0"
                >
                  {part.label}
                </button>
              ))}
            </div>
          </div>

          <!-- 疾病列表：手机单列、桌面双列卡片 -->
          <div id="disease-list" class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4">
            {articles.map((article) => {
              const sev = SEVERITY_CONFIG[article.data.severity] ?? SEVERITY_CONFIG.warning;
              const bodyPartsStr = (article.data.bodyParts ?? ['all']).join(',');
              const pathogenLabel = article.data.pathogenType
                ? PATHOGEN_TYPE_LABELS[article.data.pathogenType] ?? '综合'
                : '综合指南';

              return (
                <a
                  href={`/disease/${article.id}/`}
                  data-body-parts={bodyPartsStr}
                  class="disease-item group block bg-white rounded-xl border border-slate-200/90 p-4 sm:p-5 shadow-xs hover:shadow-sm hover:border-slate-400 hover:-translate-y-0.5 active:bg-slate-50 transition-all duration-200 flex flex-col justify-between"
                >
                  <div>
                    <!-- 顶部极简状态点 -->
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <div class="flex items-center gap-1.5">
                        <span class={`w-1.5 h-1.5 rounded-full ${sev.dotClass}`}></span>
                        <span class="text-[11px] font-medium text-slate-600">
                          {sev.label}
                        </span>
                      </div>
                      {article.data.isolationRequired && (
                        <span class="text-[11px] text-rose-600 font-medium">
                          须隔离
                        </span>
                      )}
                    </div>

                    <!-- 疾病标题 -->
                    <h3 class="text-base font-bold text-slate-900 group-hover:text-aqua-700 transition-colors">
                      {article.data.title}
                    </h3>

                    <!-- 典型表现 -->
                    {article.data.subtitle && (
                      <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
                        {article.data.subtitle}
                      </p>
                    )}

                    <!-- 处置方向 -->
                    {article.data.emergencyAction && (
                      <div class="mt-3 pt-2.5 border-t border-slate-100 text-xs leading-relaxed">
                        <span class="font-semibold text-slate-900">处置：</span>
                        <span class="text-slate-600">{article.data.emergencyAction}</span>
                      </div>
                    )}
                  </div>

                  <!-- 底部元数据 -->
                  <div class="mt-4 pt-2.5 border-t border-slate-100/80 flex items-center justify-between text-[11px] text-slate-400">
                    <span class="inline-flex items-center text-slate-500 font-medium bg-slate-50 px-1.5 py-0.5 rounded border border-slate-100">
                      {pathogenLabel}
                    </span>
                    <span class="text-slate-400 group-hover:text-slate-900 transition-colors font-medium inline-flex items-center gap-1">
                      <span>查看处方</span>
                      <ArrowRight class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
                    </span>
                  </div>
                </a>
              );
            })}
          </div>

          <!-- 空态 -->
          <div id="triage-empty" class="hidden text-center py-10 bg-white rounded-xl border border-slate-200">
            <p class="text-xs font-medium text-slate-500">该部位暂无特定疾病条目</p>
            <button
              type="button"
              id="triage-reset-btn"
              class="mt-2.5 px-3 py-1 rounded-lg bg-slate-900 text-white text-xs font-medium hover:bg-slate-800 cursor-pointer"
            >
              查看全部疾病
            </button>
          </div>
        </div>

        <!-- TAB 2: 急救与老三样准则 (Emergency) -->
        <div id="tab-panel-emergency" class="tab-panel hidden space-y-5 sm:space-y-6">
          <div>
            <div class="flex items-baseline justify-between mb-1">
              <h3 class="text-base font-bold text-slate-900">黄金急救处置三步法</h3>
              <span class="text-[11px] text-slate-400 font-medium">严禁颠倒操作次序</span>
            </div>
            <p class="text-xs text-slate-500 mb-3.5">发现鱼病异常时切勿盲目全缸倒药，请严格遵循以下标准程序。</p>

            <!-- 三步法卡片之间带连接箭头 -->
            <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr_auto_1fr] items-stretch md:items-center gap-2.5 sm:gap-3">
              <!-- Step 1 -->
              <div class="bg-white rounded-xl border border-slate-200/90 p-4 sm:p-5 shadow-xs flex flex-col justify-between h-full">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <div class="w-7 h-7 rounded-lg bg-aqua-50 border border-aqua-100 text-aqua-700 grid place-items-center">
                      <Wind class="w-3.5 h-3.5" />
                    </div>
                    <span class="text-[11px] font-bold text-slate-400 tracking-wider">STEP 01</span>
                  </div>
                  <h4 class="text-sm font-bold text-slate-900 mt-0.5 mb-1">隔离与打氧</h4>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    将病鱼以最低惊扰移入独立治疗裸缸（无底砂水草），避免传染全缸。原缸换水 1/3。隔离缸必须持续打气爆氧。
                  </p>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 text-[11px]">
                  <span class="font-medium text-slate-500">核心目标：阻断传染源</span>
                </div>
              </div>

              <!-- 连接箭头 1 ➔ 2 -->
              <div class="hidden md:flex justify-center text-slate-300">
                <ArrowRight class="w-4 h-4 text-slate-300" />
              </div>
              <div class="flex md:hidden justify-center py-0.5 text-slate-300">
                <ArrowDown class="w-3.5 h-3.5 text-slate-300" />
              </div>

              <!-- Step 2 -->
              <div class="bg-white rounded-xl border border-slate-200/90 p-4 sm:p-5 shadow-xs flex flex-col justify-between h-full">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <div class="w-7 h-7 rounded-lg bg-amber-50 border border-amber-100 text-amber-700 grid place-items-center">
                      <Thermometer class="w-3.5 h-3.5" />
                    </div>
                    <span class="text-[11px] font-bold text-slate-400 tracking-wider">STEP 02</span>
                  </div>
                  <h4 class="text-sm font-bold text-slate-900 mt-0.5 mb-1">停食与控温</h4>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    治疗期间停食 2-3 天，降低肠胃与水质负担。若需升温治疗，每天升幅不得超过 2℃，切忌急剧升降温。
                  </p>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 text-[11px]">
                  <span class="font-medium text-slate-500">核心目标：稳定鱼体状态</span>
                </div>
              </div>

              <!-- 连接箭头 2 ➔ 3 -->
              <div class="hidden md:flex justify-center text-slate-300">
                <ArrowRight class="w-4 h-4 text-slate-300" />
              </div>
              <div class="flex md:hidden justify-center py-0.5 text-slate-300">
                <ArrowDown class="w-3.5 h-3.5 text-slate-300" />
              </div>

              <!-- Step 3 -->
              <div class="bg-white rounded-xl border border-slate-200/90 p-4 sm:p-5 shadow-xs flex flex-col justify-between h-full">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <div class="w-7 h-7 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-700 grid place-items-center">
                      <ShieldCheck class="w-3.5 h-3.5" />
                    </div>
                    <span class="text-[11px] font-bold text-slate-400 tracking-wider">STEP 03</span>
                  </div>
                  <h4 class="text-sm font-bold text-slate-900 mt-0.5 mb-1">对症与撤炭</h4>
                  <p class="text-xs text-slate-600 leading-relaxed">
                    确认病因后再行规范用药，严格遵循说明书下限。用药前必须取出过滤中的活性炭，避免药物被吸附失效。
                  </p>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100 text-[11px]">
                  <span class="font-medium text-slate-500">核心目标：精准高效根治</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 老三样实战避坑 -->
          <div class="bg-white rounded-xl border border-slate-200/90 p-4 sm:p-6 shadow-xs">
            <h3 class="text-base font-bold text-slate-900 mb-1">「老三样（升温 / 加盐 / 换水）」实战准则</h3>
            <p class="text-xs text-slate-500 mb-3.5">老三样是温和调理法，但绝非万能神药。请严格对照以下适用与禁止边界。</p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
              <div class="bg-slate-50 rounded-lg p-3.5 sm:p-4 border border-slate-200/70">
                <h4 class="text-xs font-bold text-emerald-900 mb-2 flex items-center gap-1.5">
                  <Check class="w-3.5 h-3.5 text-emerald-600" />
                  何时可以使用「老三样」
                </h4>
                <ul class="space-y-1.5 text-xs text-slate-700 leading-relaxed">
                  <li>• <strong>白点病初期</strong>：升温至 28-30℃ 可加速小瓜虫脱落，配合 0.3% 粗盐效果最好。</li>
                  <li>• <strong>运输应激 / 轻微缩鳍</strong>：等温困水换水 1/3 + 0.1-0.2% 粗盐调节渗透压，静养自愈。</li>
                  <li>• <strong>轻微擦伤</strong>：保持水质清洁微盐静养，避免二次细菌感染。</li>
                </ul>
              </div>

              <div class="bg-slate-50 rounded-lg p-3.5 sm:p-4 border border-slate-200/70">
                <h4 class="text-xs font-bold text-rose-900 mb-2 flex items-center gap-1.5">
                  <X class="w-3.5 h-3.5 text-rose-600" />
                  何时绝对禁止「老三样」
                </h4>
                <ul class="space-y-1.5 text-xs text-slate-700 leading-relaxed">
                  <li>• <strong>水霉病严禁高温</strong>：水霉真菌耐受较高温度，盲目加温会加速病鱼体力衰竭。</li>
                  <li>• <strong>腹水 / 炸鳞严禁高盐</strong>：内脏水肿时下浓盐水会破坏渗透压，直接导致衰竭。</li>
                  <li>• <strong>烂鳃 / 氨氮超标严禁升温</strong>：水温越高水中溶氧越低、氨毒性剧增。</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: 水体用盐/用药剂量计算器 (Calculator) -->
        <div id="tab-panel-calculator" class="tab-panel hidden">
          <div class="bg-white rounded-xl border border-slate-200/90 p-4 sm:p-6 shadow-xs grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6">
            <!-- 左侧输入区 -->
            <div class="lg:col-span-5 space-y-3.5 sm:space-y-4">
              <div>
                <h3 class="text-base font-bold text-slate-900">鱼缸参数设置</h3>
                <p class="text-xs text-slate-400 mt-0.5">支持按尺寸换算或直接输入升数</p>
              </div>

              <!-- 双模式切换 -->
              <div class="bg-slate-100 p-0.5 rounded-lg flex items-center text-xs font-medium">
                <button
                  type="button"
                  id="calc-mode-dim"
                  class="calc-mode-btn flex-1 py-1 px-2 rounded-md bg-white text-slate-900 shadow-2xs cursor-pointer transition-all flex items-center justify-center gap-1"
                >
                  <Sliders class="w-3 h-3" />
                  <span>按尺寸换算</span>
                </button>
                <button
                  type="button"
                  id="calc-mode-direct"
                  class="calc-mode-btn flex-1 py-1 px-2 rounded-md text-slate-600 hover:text-slate-900 cursor-pointer transition-all flex items-center justify-center gap-1"
                >
                  <Hash class="w-3 h-3" />
                  <span>直接输入升数</span>
                </button>
              </div>

              <!-- 模式 A：长宽高输入面板 -->
              <div id="panel-mode-dim" class="space-y-3">
                <div class="grid grid-cols-3 gap-2">
                  <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">长 (cm)</label>
                    <input
                      type="number"
                      id="tank-length"
                      value="40"
                      min="5"
                      max="300"
                      class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-900 font-bold text-sm focus:outline-none focus:border-slate-900"
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">宽 (cm)</label>
                    <input
                      type="number"
                      id="tank-width"
                      value="30"
                      min="5"
                      max="200"
                      class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-900 font-bold text-sm focus:outline-none focus:border-slate-900"
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">水深 (cm)</label>
                    <input
                      type="number"
                      id="tank-height"
                      value="30"
                      min="5"
                      max="150"
                      class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-900 font-bold text-sm focus:outline-none focus:border-slate-900"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">造景与底砂占用扣除</label>
                  <select
                    id="tank-deduction"
                    class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-800 text-xs focus:outline-none focus:border-slate-900 cursor-pointer"
                  >
                    <option value="0.9">扣除 10%（少量底砂 / 水草）- 推荐</option>
                    <option value="1.0">不扣除（纯裸缸 / 隔离小缸）</option>
                    <option value="0.8">扣除 20%（厚底砂 / 大造景石）</option>
                  </select>
                </div>

                <div>
                  <span class="block text-[11px] font-medium text-slate-400 mb-1">常用鱼缸尺寸一键选择：</span>
                  <div class="grid grid-cols-2 gap-1.5">
                    <button type="button" class="preset-btn text-xs font-medium px-2 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 hover:border-slate-300 cursor-pointer transition-colors text-left truncate" data-l="30" data-w="20" data-h="20">
                      30 方缸 (12L)
                    </button>
                    <button type="button" class="preset-btn text-xs font-medium px-2 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 hover:border-slate-300 cursor-pointer transition-colors text-left truncate" data-l="40" data-w="30" data-h="30">
