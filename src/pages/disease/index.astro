<script>
  function initDiseasePage() {
    // 1. Tab 切换逻辑
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');

    function switchTab(targetTab: string) {
      tabButtons.forEach((btn) => {
        const isActive = btn.dataset.tab === targetTab;
        btn.dataset.active = isActive ? 'true' : 'false';
      });

      tabPanels.forEach((panel) => {
        const isPanelActive = panel.id === `tab-panel-${targetTab}`;
        panel.classList.toggle('hidden', !isPanelActive);
      });
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;
        if (tab) switchTab(tab);
      });
    });

    // 2. 部位筛选逻辑
    const partButtons = document.querySelectorAll<HTMLButtonElement>('.part-pill');
    const diseaseItems = document.querySelectorAll<HTMLElement>('.disease-item');
    const emptyState = document.getElementById('triage-empty');
    const resetBtn = document.getElementById('triage-reset-btn');

    let activePart = 'all';

    function applyPartFilter() {
      let visible = 0;
      diseaseItems.forEach((item) => {
        const parts = (item.dataset.bodyParts || '').split(',');
        const match = activePart === 'all' || parts.includes(activePart) || parts.includes('all');
        item.classList.toggle('hidden', !match);
        if (match) visible++;
      });
      if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    }

    partButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.value;
        if (!val) return;
        activePart = val;

        partButtons.forEach((b) => {
          b.dataset.active = (b === btn) ? 'true' : 'false';
        });

        applyPartFilter();
      });
    });

    resetBtn?.addEventListener('click', () => {
      activePart = 'all';
      partButtons.forEach((b) => {
        b.dataset.active = (b.dataset.value === 'all') ? 'true' : 'false';
      });
      applyPartFilter();
    });

    // 3. 计算器逻辑（支持双模式输入与一键复制备忘）
    const btnModeDim = document.getElementById('calc-mode-dim');
    const btnModeDirect = document.getElementById('calc-mode-direct');
    const panelModeDim = document.getElementById('panel-mode-dim');
    const panelModeDirect = document.getElementById('panel-mode-direct');

    const lenInput = document.getElementById('tank-length') as HTMLInputElement | null;
    const widInput = document.getElementById('tank-width') as HTMLInputElement | null;
    const heiInput = document.getElementById('tank-height') as HTMLInputElement | null;
    const dedSelect = document.getElementById('tank-deduction') as HTMLSelectElement | null;
    const directInput = document.getElementById('direct-volume-input') as HTMLInputElement | null;

    const resVolume = document.getElementById('res-volume');
    const resSalt01 = document.getElementById('res-salt-01');
    const resSalt03 = document.getElementById('res-salt-03');
    const resSalt05 = document.getElementById('res-salt-05');
    const resMedMbMl = document.getElementById('res-med-mb-ml');
    const resMedYf = document.getElementById('res-med-yf');
    const resMedMn = document.getElementById('res-med-mn');

    const copyBtn = document.getElementById('copy-memo-btn');
    const copyText = document.getElementById('copy-text');

    let currentMode: 'dim' | 'direct' = 'dim';
    let computedNetLiters = 32.4;

    function setCalcMode(mode: 'dim' | 'direct') {
      currentMode = mode;
      const isDim = mode === 'dim';

      btnModeDim?.classList.toggle('bg-white', isDim);
      btnModeDim?.classList.toggle('text-slate-900', isDim);
      btnModeDim?.classList.toggle('shadow-2xs', isDim);
      btnModeDim?.classList.toggle('text-slate-600', !isDim);

      btnModeDirect?.classList.toggle('bg-white', !isDim);
      btnModeDirect?.classList.toggle('text-slate-900', !isDim);
      btnModeDirect?.classList.toggle('shadow-2xs', !isDim);
      btnModeDirect?.classList.toggle('text-slate-600', isDim);

      panelModeDim?.classList.toggle('hidden', !isDim);
      panelModeDirect?.classList.toggle('hidden', isDim);

      calculate();
    }

    btnModeDim?.addEventListener('click', () => setCalcMode('dim'));
    btnModeDirect?.addEventListener('click', () => setCalcMode('direct'));

    function calculate() {
      let netLiters = 30;

      if (currentMode === 'dim') {
        if (!lenInput || !widInput || !heiInput || !dedSelect) return;
        const l = Math.max(5, parseFloat(lenInput.value) || 0);
        const w = Math.max(5, parseFloat(widInput.value) || 0);
        const h = Math.max(5, parseFloat(heiInput.value) || 0);
        const factor = parseFloat(dedSelect.value) || 0.9;
        const rawLiters = (l * w * h) / 1000;
        netLiters = Math.max(0.5, Math.round(rawLiters * factor * 10) / 10);
      } else {
        if (!directInput) return;
        netLiters = Math.max(0.5, parseFloat(directInput.value) || 0);
      }

      computedNetLiters = netLiters;

      if (resVolume) resVolume.textContent = netLiters.toFixed(1);

      // 粗盐克数计算：0.1% = 1g/L, 0.3% = 3g/L, 0.5% = 5g/L
      if (resSalt01) resSalt01.textContent = String(Math.round(netLiters * 1));
      if (resSalt03) resSalt03.textContent = String(Math.round(netLiters * 3));
      if (resSalt05) resSalt05.textContent = String(Math.round(netLiters * 5));

      // 亚甲基蓝（市售 1% 水剂）：持续药浴 2ppm 对应每 10L 水约 2mL
      const mbMl = Math.max(0.1, Math.round(netLiters * 0.2 * 10) / 10);
      if (resMedMbMl) resMedMbMl.textContent = mbMl.toFixed(1);

      // 黄粉（全缸药浴）：1-2ppm (0.01g/L，即 100L 水用 1g，水色微黄)
      const yfG = Math.max(0.05, Math.round(netLiters * 0.01 * 10) / 10);
      if (resMedYf) resMedYf.textContent = yfG.toFixed(1);

      // 甲硝唑：每 25L 水投 1 粒 (200mg/粒)
      const mnPills = Math.max(0.1, Math.round((netLiters / 25) * 10) / 10);
      if (resMedMn) resMedMn.textContent = mnPills.toFixed(1);
    }

    [lenInput, widInput, heiInput, dedSelect, directInput].forEach((el) => {
      el?.addEventListener('input', calculate);
      el?.addEventListener('change', calculate);
    });

    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!lenInput || !widInput || !heiInput) return;
        lenInput.value = btn.dataset.l || '40';
        widInput.value = btn.dataset.w || '30';
        heiInput.value = btn.dataset.h || '30';
        calculate();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.quick-liters-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!directInput) return;
        directInput.value = btn.dataset.liters || '30';
        calculate();
      });
    });

    // 复制备忘
    copyBtn?.addEventListener('click', async () => {
      const volumeStr = computedNetLiters.toFixed(1);
      const salt03 = Math.round(computedNetLiters * 3);
      const salt01 = Math.round(computedNetLiters * 1);
      const mbMl = (computedNetLiters * 0.2).toFixed(1);
      const yfG = (computedNetLiters * 0.01).toFixed(1);
      const mnPills = (computedNetLiters / 25).toFixed(1);

      const memoText = `【孔雀鱼水体用药处方备忘】\n• 净水容积：${volumeStr} 升 (L)\n• 粗盐推荐：轻症常用 0.3%（${salt03}g）| 保健 0.1%（${salt01}g）\n• 亚甲基蓝：约 ${mbMl} mL（市售 1% 标准水剂持续药浴）\n• 黄粉/水族专用：约 ${yfG} g（全缸温和药浴，水色微黄）\n• 甲硝唑：约 ${mnPills} 粒（200mg/粒，温水化开）\n※ 注意：螺虾弱鱼剂量减半，药浴期间必须取出过滤活性炭！`;

      try {
        await navigator.clipboard.writeText(memoText);
        if (copyText) copyText.textContent = '已复制！';
        copyBtn.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
        setTimeout(() => {
          if (copyText) copyText.textContent = '复制备忘';
          copyBtn.classList.remove('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
        }, 2000);
      } catch {
        alert(memoText);
      }
    });

    calculate();
  }

  document.addEventListener('astro:page-load', initDiseasePage);
  initDiseasePage();
</script>
