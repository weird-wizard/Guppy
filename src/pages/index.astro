---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreedImage, { COLOR_GRADIENTS, COLOR_GLOWS } from '../components/BreedImage.astro';
import { getCollection } from 'astro:content';

const breeds = (await getCollection('breeds')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const featured = breeds.slice(0, 6);

const guides = await getCollection('guides');
const breeding = await getCollection('breeding');
const disease = await getCollection('disease');

const sections = [
  {
    href: '/guide/',
    title: '饲养指南',
    desc: '开缸养水、水质管理、喂食混养，从零养好孔雀鱼',
    count: guides.length,
    icon: 'M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z',
  },
  {
    href: '/breeding/',
    title: '繁殖技术',
    desc: '孕期管理、小鱼护理、品系提纯选育',
    count: breeding.length,
    icon: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z',
  },
  {
    href: '/disease/',
    title: '疾病防治',
    desc: '常见病速查、用药指南、检疫预防',
    count: disease.length,
    icon: 'M2.5 12c3-4.5 6.5-6.5 9.5-6.5 3.2 0 5.4 1.5 6.8 4.2l3.2-1.7v8l-3.2-1.7c-1.4 2.7-3.6 4.2-6.8 4.2-3 0-6.5-2-9.5-6.5zM9.5 10.5v3M8 12h3',
  },
];

// 统计行：全部由 getCollection 动态计算
const statItems = [
  { value: breeds.length, label: '品种档案' },
  { value: guides.length + breeding.length + disease.length, label: '知识文章' },
  { value: sections.length, label: '内容栏目' },
];

// 品种卡片复用映射（与 breeds/index 保持一致）
const COLOR_LABELS: Record<string, string> = {
  red: '红色', blue: '蓝色', green: '绿色', yellow: '黄色', purple: '紫色',
  white: '白色', black: '黑色', snake: '蛇纹', multi: '多彩',
};
const DIFFICULTY_BADGES: Record<string, { label: string; className: string }> = {
  beginner: { label: '入门', className: 'bg-aqua-100 text-aqua-700' },
  intermediate: { label: '进阶', className: 'bg-amber-100 text-amber-700' },
  advanced: { label: '高手', className: 'bg-coral-100 text-coral-700' },
};
---

<BaseLayout>
  {/* Hero：深藏蓝深海渐变 */}
  <section class="relative overflow-hidden bg-gradient-to-b from-abyss-950 via-abyss-900 to-abyss-800 text-white">
    {/* 水生动效层：气泡 + 3D 立体游动孔雀鱼 */}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden select-none" style="perspective: 1200px; transform-style: preserve-3d;">
      <!-- 气泡 -->
      <span class="absolute bottom-4 left-[6%] h-2.5 w-2.5 rounded-full bg-white/15 border border-white/25 animate-guppy-rise" style="animation-delay: 0.5s; animation-duration: 8s"></span>
      <span class="absolute bottom-10 left-[18%] h-4 w-4 rounded-full bg-white/10 border border-white/20 animate-guppy-rise" style="animation-delay: 2.2s; animation-duration: 11s"></span>
      <span class="absolute bottom-6 left-[34%] h-2 w-2 rounded-full bg-aqua-300/25 border border-aqua-200/30 animate-guppy-rise" style="animation-delay: 3.4s; animation-duration: 9.5s"></span>
      <span class="absolute bottom-8 left-[55%] h-2.5 w-2.5 rounded-full bg-white/10 border border-white/20 animate-guppy-rise" style="animation-delay: 5.4s; animation-duration: 9s"></span>
      <span class="absolute bottom-14 right-[40%] h-3.5 w-3.5 rounded-full bg-aqua-200/15 border border-aqua-100/25 animate-guppy-rise" style="animation-delay: 2.8s; animation-duration: 10.5s"></span>
      <span class="absolute bottom-12 right-[22%] h-3 w-3 rounded-full bg-white/15 border border-white/25 animate-guppy-rise" style="animation-delay: 1.2s; animation-duration: 10s"></span>
      <span class="absolute bottom-5 right-[8%] h-5 w-5 rounded-full bg-coral-400/15 border border-coral-300/25 animate-guppy-rise" style="animation-delay: 4s; animation-duration: 12s"></span>

      <!-- 游动孔雀鱼 1（主景：水蓝大扇尾，中上层鱼缸内自主巡游） -->
      <div
        class="absolute top-[22%] left-[15%] w-18 sm:w-22 text-aqua-300 animate-tank-fish-1 filter drop-shadow-[0_4px_16px_rgba(53,164,255,0.45)]"
      >
        <svg viewBox="0 0 120 60" class="w-full h-auto overflow-visible" fill="none">
          <!-- 飘逸大尾鳍（起点严密锚定在尾柄 (36, 30)，多维水波摆动） -->
          <g class="animate-fish-tail" style="transform-origin: 36px 30px;">
            <path
              d="M36 30 C20 12, 6 4, 2 12 C-2 20, 0 38, 4 46 C8 54, 20 48, 36 30 Z"
              fill="url(#guppy-tail-grad-1)"
              opacity="0.95"
            />
            <!-- 尾鳍丝绸流纹（全部从 (36,30) 辐射展开） -->
            <path d="M36 30 Q20 18 5 16" stroke="rgba(255,255,255,0.6)" stroke-width="0.8" fill="none" />
            <path d="M36 30 Q18 30 3 30" stroke="rgba(255,255,255,0.45)" stroke-width="0.8" fill="none" />
            <path d="M36 30 Q20 42 6 44" stroke="rgba(255,255,255,0.6)" stroke-width="0.8" fill="none" />
          </g>
          <!-- 鱼身主体（纺锤形，尾柄后端精准闭合于 (36, 30)） -->
          <path
            d="M36 30 C38 23, 58 18, 80 22 C92 24, 100 28, 100 28 C100 28, 92 32, 80 36 C58 40, 38 37, 36 30 Z"
            fill="url(#guppy-body-grad-1)"
          />
          <!-- 背鳍（紧贴鱼背） -->
          <path d="M52 19 C56 10, 68 8, 72 19 Z" fill="rgba(92,195,255,0.75)" />
          <!-- 腹部胸鳍（生长点紧扣鱼肋 (66, 33)，轻柔慢划） -->
          <path
            d="M66 33 C62 39, 55 43, 51 41 C49 39, 54 33, 66 33 Z"
            fill="rgba(255,255,255,0.7)"
            class="animate-fish-pectoral"
            style="transform-origin: 66px 33px;"
          />
          <!-- 眼睛与高光 -->
          <circle cx="88" cy="27" r="1.8" fill="#081830" />
          <circle cx="88.5" cy="26.5" r="0.6" fill="#ffffff" />
          <defs>
            <linearGradient id="guppy-tail-grad-1" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#35a4ff" stop-opacity="0.95" />
              <stop offset="60%" stop-color="#90daff" stop-opacity="0.85" />
              <stop offset="100%" stop-color="#ff7f6e" stop-opacity="0.65" />
            </linearGradient>
            <linearGradient id="guppy-body-grad-1" x1="0%" y1="50%" x2="100%" y2="50%">
              <stop offset="0%" stop-color="#1f84f5" />
              <stop offset="70%" stop-color="#bde8ff" />
              <stop offset="100%" stop-color="#ffffff" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- 游动孔雀鱼 2（中景：珊瑚红大扇尾，中下层鱼缸内自主巡游） -->
      <div
        class="absolute top-[48%] left-[62%] w-16 sm:w-18 text-coral-400 animate-tank-fish-2 filter drop-shadow-[0_4px_14px_rgba(245,86,67,0.38)]"
      >
        <svg viewBox="0 0 120 60" class="w-full h-auto overflow-visible" fill="none">
          <g class="animate-fish-tail" style="transform-origin: 36px 30px;">
            <path
              d="M36 30 C18 10, 4 4, 1 12 C-3 20, -1 36, 4 44 C9 52, 20 46, 36 30 Z"
              fill="url(#guppy-tail-grad-2)"
              opacity="0.95"
            />
            <path d="M36 30 Q18 16 4 14" stroke="rgba(255,255,255,0.55)" stroke-width="0.8" fill="none" />
            <path d="M36 30 Q18 30 2 30" stroke="rgba(255,255,255,0.4)" stroke-width="0.8" fill="none" />
            <path d="M36 30 Q18 44 5 46" stroke="rgba(255,255,255,0.55)" stroke-width="0.8" fill="none" />
          </g>
          <path
            d="M36 30 C38 23, 58 18, 80 22 C92 24, 100 28, 100 28 C100 28, 92 32, 80 36 C58 40, 38 37, 36 30 Z"
            fill="url(#guppy-body-grad-2)"
          />
          <path d="M50 19 C54 10, 66 8, 70 19 Z" fill="rgba(255,166,153,0.75)" />
          <path
            d="M66 33 C62 39, 55 43, 51 41 C49 39, 54 33, 66 33 Z"
            fill="rgba(255,255,255,0.7)"
            class="animate-fish-pectoral"
            style="transform-origin: 66px 33px;"
          />
          <circle cx="88" cy="27" r="1.7" fill="#081830" />
          <circle cx="88.5" cy="26.5" r="0.5" fill="#ffffff" />
          <defs>
            <linearGradient id="guppy-tail-grad-2" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#f55643" stop-opacity="0.95" />
              <stop offset="60%" stop-color="#fbbf24" stop-opacity="0.85" />
              <stop offset="100%" stop-color="#ffa699" stop-opacity="0.65" />
            </linearGradient>
            <linearGradient id="guppy-body-grad-2" x1="0%" y1="50%" x2="100%" y2="50%">
              <stop offset="0%" stop-color="#e03a28" />
              <stop offset="70%" stop-color="#ffd5cf" />
              <stop offset="100%" stop-color="#ffffff" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- 游动孔雀鱼 3（远景深水小鱼：深水区中央小范围巡弋） -->
      <div
        class="absolute top-[62%] left-[40%] w-12 sm:w-14 text-aqua-200 animate-tank-fish-3 filter blur-[0.4px] opacity-60"
      >
        <svg viewBox="0 0 120 60" class="w-full h-auto overflow-visible" fill="none">
          <g class="animate-fish-tail" style="transform-origin: 36px 30px;">
            <path
              d="M36 30 C20 14, 8 8, 4 16 C1 24, 2 34, 5 40 C9 46, 20 42, 36 30 Z"
              fill="rgba(92,195,255,0.65)"
            />
          </g>
          <path
            d="M36 30 C38 23, 58 18, 80 22 C92 24, 100 28, 100 28 C100 28, 92 32, 80 36 C58 40, 38 37, 36 30 Z"
            fill="rgba(255,255,255,0.75)"
          />
          <path
            d="M66 33 C62 39, 55 43, 51 41 C49 39, 54 33, 66 33 Z"
            fill="rgba(255,255,255,0.55)"
            class="animate-fish-pectoral"
            style="transform-origin: 66px 33px;"
          />
          <circle cx="88" cy="27" r="1.5" fill="#081830" />
        </svg>
      </div>
    </div>
    {/* 学名衬线斜体水印 */}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -right-4 top-8 hidden select-none font-serif italic text-5xl sm:text-7xl text-white/[0.06] tracking-wide -rotate-6 sm:block"
    >
      Poecilia reticulata
    </span>
    <div class="relative max-w-6xl mx-auto px-4 py-20 sm:py-28 lg:py-36 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/15 text-aqua-100 text-xs sm:text-sm font-medium mb-6 backdrop-blur-sm whitespace-nowrap max-w-full overflow-hidden animate-fade-up" style="animation-delay: 0ms">
        <span>Poecilia reticulata</span>
        <span class="text-white/40">·</span>
        <span>花鳉科</span>
        <span class="text-white/40">·</span>
        <span>卵胎生</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight animate-fade-up" style="animation-delay: 80ms">
        孔雀鱼知识百科
      </h1>
      <p class="mt-6 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed animate-fade-up" style="animation-delay: 160ms">
        <span class="text-white/95 font-medium">品种图鉴 · 饲养指南 · 繁殖技术 · 疾病防治</span>
        <span class="block mt-1 sm:inline sm:mt-0 text-aqua-200/75 sm:before:content-['·_']">面向爱好者的孔雀鱼中文百科</span>
      </p>
      {/* 统计数据行 */}
      <dl class="mt-10 flex flex-wrap justify-center gap-x-12 gap-y-5 animate-fade-up" style="animation-delay: 240ms">
        {statItems.map((stat) => (
          <div class="text-center">
            <div aria-hidden="true" class="mx-auto mb-3 h-px w-10 bg-gradient-to-r from-transparent via-aqua-300 to-transparent"></div>
            <dd class="text-3xl font-bold text-aqua-100 tabular-nums">{stat.value}</dd>
            <dt class="mt-1 text-xs tracking-[0.2em] text-aqua-200/70">{stat.label}</dt>
          </div>
        ))}
      </dl>
      <div class="mt-10 flex flex-wrap justify-center gap-4 animate-fade-up" style="animation-delay: 320ms">
        <a
          href="/breeds/"
          class="btn-press px-8 py-3.5 rounded-full bg-coral-500 text-white font-semibold hover:bg-coral-400 shadow-lg shadow-coral-500/25 hover:shadow-coral-500/40 transition-all ease-[var(--ease-spring)] hover:-translate-y-0.5 active:scale-95"
        >
          浏览品种图鉴
        </a>
        <a
          href="/guide/"
          class="btn-press px-8 py-3.5 rounded-full bg-white/10 text-white font-semibold border border-white/20 hover:bg-white/15 backdrop-blur-sm transition-all ease-[var(--ease-spring)] active:scale-95 active:bg-white/20"
        >
          新手入门指南
        </a>
      </div>
    </div>
    {/* 波浪过渡到浅色内容区（颜色匹配下方背景，-mb-px 消除亚像素渲染黑线） */}
    <div aria-hidden="true" class="relative -mb-px h-10 w-full overflow-hidden leading-none text-[#eef4fb]">
      <svg viewBox="0 0 1440 40" preserveAspectRatio="none" class="block h-full w-full">
        <path fill="currentColor" d="M0 40V26c240 22 480-20 720 0s480 22 720 0v14z" />
      </svg>
    </div>
  </section>

  <!-- 栏目导航 -->
  <section class="max-w-6xl mx-auto px-4 py-[var(--spacing-section)]">
    <div class="grid sm:grid-cols-3 gap-6">
      {sections.map((s, i) => (
        <a
          href={s.href}
          class="group relative bg-white rounded-2xl border border-slate-200 shadow-card hover:shadow-card-hover hover:-translate-y-1.5 transition-all duration-300 overflow-hidden flex"
        >
          {/* 左侧竖排编号徽章 */}
          <div
            aria-hidden="true"
            class="shrink-0 w-10 bg-abyss-900 flex items-center justify-center transition-colors duration-300 group-hover:bg-coral-500"
          >
            <span class="font-serif text-white/40 group-hover:text-white/80 transition-colors duration-300 text-lg" style="writing-mode: vertical-rl">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <div class="p-6 flex-1">
            <div
              class="w-12 h-12 rounded-xl bg-aqua-50 border border-aqua-200 text-aqua-600 grid place-items-center"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={s.icon} />
              </svg>
            </div>
            <h2 class="mt-5 text-xl font-bold text-slate-900 group-hover:text-aqua-700 transition-colors">
              {s.title}
            </h2>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{s.desc}</p>
            <p class="mt-4 text-xs text-slate-400">{s.count} 篇文章</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 热门品种 -->
  {featured.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 pb-[var(--spacing-section)]">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="eyebrow mb-2">品种图鉴</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">精选品种</h2>
        </div>
        <a href="/breeds/" class="text-sm text-aqua-600 hover:text-aqua-700 font-medium">
          查看全部 {breeds.length} 个品种 →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.map((breed) => (
          <article
            style={`--card-glow: ${COLOR_GLOWS[breed.data.color]};`}
            class="breed-card-aura group bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-card hover:-translate-y-1.5 hover:border-aqua-300 transition-all duration-300 flex flex-col"
          >
            <a href={`/breed/${breed.id}/`} class="block flex-1 flex flex-col">
              <div class="relative aspect-[4/3] overflow-hidden">
                <div class="h-full transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.05]">
                  <BreedImage
                    alt={breed.data.title}
                    image={breed.data.image?.src}
                    gradientFrom={COLOR_GRADIENTS[breed.data.color]}
                  />
                </div>
              </div>
              <div class="p-6 flex flex-col gap-3 flex-1">
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-aqua-700 transition-colors">
                  {breed.data.title}
                </h3>
                {breed.data.enName && (
                  <p class="text-xs text-slate-400 font-serif italic mt-0.5">{breed.data.enName}</p>
                )}
                <p class="text-xs font-medium text-aqua-600">{breed.data.family}</p>
                {breed.data.subtitle && (
                  <p class="text-sm text-slate-600 line-clamp-2">{breed.data.subtitle}</p>
                )}
                <div class="mt-auto pt-3 flex items-center justify-between gap-2">
                  <span
                    class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${DIFFICULTY_BADGES[breed.data.difficulty].className}`}
                  >
                    {DIFFICULTY_BADGES[breed.data.difficulty].label}
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-xs text-slate-400">
                    <span
                      class="w-2 h-2 rounded-full"
                      style={`background: ${COLOR_GRADIENTS[breed.data.color]}`}
                      aria-hidden="true"
                    ></span>
                    {COLOR_LABELS[breed.data.color]}
                  </span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- 关于 -->
  <section class="bg-gradient-to-b from-abyss-900 to-abyss-950 text-slate-300">
    <div class="max-w-6xl mx-auto px-4 py-16 grid md:grid-cols-2 gap-10">
      <div>
        <h2 class="text-2xl font-bold text-white">关于孔雀鱼</h2>
        <p class="mt-4 leading-relaxed text-slate-400">
          孔雀鱼（学名 <em class="font-serif italic text-aqua-200">Poecilia reticulata</em>，孔雀花鳉）原产于南美洲及加勒比地区，
          是花鳉科的代表鱼种。它因色彩绚丽、繁殖力强、饲养容易而风靡全球，
          至今已培育出礼服、马赛克、草尾、蛇纹、莫斯科等 17 大品系。
        </p>
        <blockquote class="mt-6 border-l-4 border-coral-400 pl-4 font-serif italic text-lg text-aqua-100/90 leading-relaxed">
          "色彩绚丽、繁殖力强、饲养容易——让它成为走进水族世界最好的敲门鱼。"
        </blockquote>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-white">本站内容</h2>
        <ul class="mt-5 space-y-3">
          <li class="flex gap-3 items-start">
            <span aria-hidden="true" class="mt-2 w-2 h-2 rounded-full bg-coral-400 shrink-0"></span>
            <span class="leading-relaxed text-slate-400">品种图鉴：17 大品系代表品种，支持颜色、鳍型、难度组合筛选。</span>
          </li>
          <li class="flex gap-3 items-start">
            <span aria-hidden="true" class="mt-2 w-2 h-2 rounded-full bg-coral-400 shrink-0"></span>
            <span class="leading-relaxed text-slate-400">知识栏目：饲养指南、繁殖技术、疾病防治，覆盖养鱼全流程。</span>
          </li>
          <li class="flex gap-3 items-start">
            <span aria-hidden="true" class="mt-2 w-2 h-2 rounded-full bg-coral-400 shrink-0"></span>
            <span class="leading-relaxed text-slate-400">内容整理自公开资料、水族论坛与专业文献，仅供学习交流，图片由 AI 生成逐步补充。</span>
          </li>
        </ul>
        {/* 数据亮点条：与 Hero stats 样式呼应 */}
        <div class="mt-8 pt-6 border-t border-abyss-800/80 flex flex-wrap gap-x-8 gap-y-4">
          <div class="text-center">
            <div aria-hidden="true" class="mx-auto mb-2 h-px w-8 bg-gradient-to-r from-transparent via-aqua-400 to-transparent"></div>
            <p class="text-2xl font-bold text-aqua-300 tabular-nums">{breeds.length}</p>
            <p class="mt-0.5 text-[0.7rem] tracking-[0.2em] text-slate-500 uppercase">品系档案</p>
          </div>
          <div class="text-center">
            <div aria-hidden="true" class="mx-auto mb-2 h-px w-8 bg-gradient-to-r from-transparent via-aqua-400 to-transparent"></div>
            <p class="text-2xl font-bold text-aqua-300 tabular-nums">{guides.length + breeding.length + disease.length}</p>
            <p class="mt-0.5 text-[0.7rem] tracking-[0.2em] text-slate-500 uppercase">知识文章</p>
          </div>
          <div class="text-center">
            <div aria-hidden="true" class="mx-auto mb-2 h-px w-8 bg-gradient-to-r from-transparent via-aqua-400 to-transparent"></div>
            <p class="text-2xl font-bold text-aqua-300 tabular-nums">{disease.length}</p>
            <p class="mt-0.5 text-[0.7rem] tracking-[0.2em] text-slate-500 uppercase">疾病速查</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
