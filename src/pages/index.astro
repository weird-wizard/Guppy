---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreedImage, { COLOR_GRADIENTS, COLOR_GLOWS } from '../components/BreedImage.astro';
import { getCollection } from 'astro:content';
import {
  Compass,
  Heart,
  Stethoscope,
  ArrowRight,
  Sparkles,
  Layers,
  ChevronRight,
  Droplets,
  ShieldAlert,
} from 'lucide-astro';

const breeds = (await getCollection('breeds')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const featured = breeds.slice(0, 8); // 8 个精选高光画廊

const guides = await getCollection('guides');
const breeding = await getCollection('breeding');
const disease = await getCollection('disease');

const FIN_LABELS: Record<string, string> = {
  delta: '三角尾', fan: '扇尾', sword: '剑尾', crown: '皇冠尾',
  ribbon: '缎带尾', round: '圆尾', flag: '旗尾', veil: '纱尾',
};
const DIFFICULTY_CONFIG: Record<string, { label: string; textClass: string; bgClass: string }> = {
  beginner: { label: '入门级', textClass: 'text-emerald-300 border-emerald-500/40', bgClass: 'bg-emerald-500/20' },
  intermediate: { label: '进阶级', textClass: 'text-amber-300 border-amber-500/40', bgClass: 'bg-amber-500/20' },
  advanced: { label: '大师级', textClass: 'text-rose-300 border-rose-500/40', bgClass: 'bg-rose-500/20' },
};
---

<BaseLayout>
  {/* ───────────────────────────────────────────── */}
  {/* 1. 殿堂级水生 Hero：纯净深海 + 3D 生物光影       */}
  {/* ───────────────────────────────────────────── */}
  <section class="relative overflow-hidden bg-gradient-to-b from-abyss-950 via-[#071328] to-[#0a1e3d] text-white">
    {/* 水生动效层：深海折射光斑 + 拟真气泡 + 3D 自由巡游孔雀鱼 */}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden select-none" style="perspective: 1200px; transform-style: preserve-3d;">
      {/* 顶部中央天青光晕 */}
      <div class="absolute -top-36 left-1/2 -translate-x-1/2 w-[48rem] h-[26rem] bg-aqua-500/15 rounded-full blur-[100px]"></div>
      {/* 右侧微光 */}
      <div class="absolute top-1/3 -right-24 w-96 h-96 bg-indigo-500/12 rounded-full blur-[90px]"></div>

      <!-- 拟真水下物理微气泡（带正弦左右漂移浮力） -->
      <span class="bubble-drift absolute bottom-4 left-[8%] h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-white/20 border border-white/30 backdrop-blur-[1px]" style="animation-delay: 0.2s; animation-duration: 9s"></span>
      <span class="bubble-drift absolute bottom-10 left-[22%] h-3 sm:h-4 w-3 sm:w-4 rounded-full bg-white/12 border border-white/25 backdrop-blur-[1px]" style="animation-delay: 2.1s; animation-duration: 11.5s"></span>
      <span class="bubble-drift absolute bottom-6 left-[38%] h-1.5 sm:h-2 w-1.5 sm:w-2 rounded-full bg-aqua-300/30 border border-aqua-200/40" style="animation-delay: 3.8s; animation-duration: 8.5s"></span>
      <span class="bubble-drift absolute bottom-8 left-[58%] h-2 sm:h-2.5 w-2 sm:w-2.5 rounded-full bg-white/15 border border-white/20" style="animation-delay: 5.1s; animation-duration: 10s"></span>
      <span class="bubble-drift absolute bottom-14 right-[32%] h-2.5 sm:h-3.5 w-2.5 sm:w-3.5 rounded-full bg-aqua-200/20 border border-aqua-100/30 backdrop-blur-[1px]" style="animation-delay: 2.7s; animation-duration: 12s"></span>
      <span class="bubble-drift absolute bottom-12 right-[15%] h-2.5 sm:h-3 w-2.5 sm:w-3 rounded-full bg-white/20 border border-white/30" style="animation-delay: 1.4s; animation-duration: 9.5s"></span>
      <span class="bubble-drift absolute bottom-5 right-[5%] h-3.5 sm:h-5 w-3.5 sm:w-5 rounded-full bg-coral-400/20 border border-coral-300/30 backdrop-blur-[1px]" style="animation-delay: 4.3s; animation-duration: 13s"></span>

      <!-- 游动孔雀鱼 1（主景：水蓝大扇尾） -->
      <div
        class="absolute top-[12%] sm:top-[16%] left-[4%] sm:left-[10%] w-16 sm:w-28 text-aqua-300 animate-tank-fish-1 filter drop-shadow-[0_6px_20px_rgba(53,164,255,0.5)]"
      >
        <svg viewBox="0 0 120 60" class="w-full h-auto overflow-visible" fill="none">
          <g class="animate-fish-tail" style="transform-origin: 36px 30px;">
            <path
              d="M36 30 C18 10, 4 3, 0 10 C-4 18, -1 38, 3 46 C8 54, 20 48, 36 30 Z"
              fill="url(#guppy-tail-grad-1)"
              opacity="0.95"
            />
            <path d="M36 30 Q18 16 3 14" stroke="rgba(255,255,255,0.7)" stroke-width="0.75" fill="none" />
            <path d="M36 30 Q16 23 0 23" stroke="rgba(255,255,255,0.5)" stroke-width="0.75" fill="none" />
            <path d="M36 30 Q16 30 0 30" stroke="rgba(255,255,255,0.4)" stroke-width="0.75" fill="none" />
            <path d="M36 30 Q16 37 0 37" stroke="rgba(255,255,255,0.5)" stroke-width="0.75" fill="none" />
            <path d="M36 30 Q18 44 4 46" stroke="rgba(255,255,255,0.7)" stroke-width="0.75" fill="none" />
          </g>
          <path
            d="M36 30 C38 22, 58 17, 80 21 C92 23, 100 27.5, 100 27.5 C100 27.5, 92 32, 80 36.5 C58 40.5, 38 37.5, 36 30 Z"
            fill="url(#guppy-body-grad-1)"
          />
          <path d="M50 18 C55 8, 68 6, 73 19 Z" fill="rgba(92,195,255,0.8)" />
          <path
            d="M66 33 C61 39, 54 44, 50 41.5 C48 39, 53 33, 66 33 Z"
            fill="rgba(255,255,255,0.75)"
            class="animate-fish-pectoral"
            style="transform-origin: 66px 33px;"
          />
          <circle cx="88" cy="26.5" r="2.2" fill="#051020" />
          <circle cx="88" cy="26.5" r="1.6" fill="#0c2340" />
          <circle cx="88.6" cy="25.9" r="0.7" fill="#ffffff" />
          <defs>
            <linearGradient id="guppy-tail-grad-1" x1="100%" y1="50%" x2="0%" y2="50%">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.98" />
              <stop offset="50%" stop-color="#818cf8" stop-opacity="0.9" />
              <stop offset="85%" stop-color="#f43f5e" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0.6" />
            </linearGradient>
            <linearGradient id="guppy-body-grad-1" x1="0%" y1="50%" x2="100%" y2="50%">
              <stop offset="0%" stop-color="#0284c7" />
              <stop offset="60%" stop-color="#7dd3fc" />
              <stop offset="90%" stop-color="#e0f2fe" />
              <stop offset="100%" stop-color="#ffffff" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- 游动孔雀鱼 2（中景：火红金黄大扇尾） -->
      <div
        class="absolute top-[54%] sm:top-[50%] right-[4%] sm:right-[10%] w-14 sm:w-22 text-coral-400 animate-tank-fish-2 filter drop-shadow-[0_6px_18px_rgba(244,63,94,0.45)]"
      >
        <svg viewBox="0 0 120 60" class="w-full h-auto overflow-visible" fill="none">
          <g class="animate-fish-tail" style="transform-origin: 36px 30px;">
            <path
              d="M36 30 C18 10, 4 4, 1 12 C-3 20, -1 36, 4 44 C9 52, 20 46, 36 30 Z"
              fill="url(#guppy-tail-grad-2)"
              opacity="0.95"
            />
            <path d="M36 30 Q18 16 4 14" stroke="rgba(255,255,255,0.6)" stroke-width="0.75" fill="none" />
            <path d="M36 30 Q16 30 1 30" stroke="rgba(255,255,255,0.4)" stroke-width="0.75" fill="none" />
            <path d="M36 30 Q18 44 5 46" stroke="rgba(255,255,255,0.6)" stroke-width="0.75" fill="none" />
          </g>
          <path
            d="M36 30 C38 22, 58 17, 80 21 C92 23, 100 27.5, 100 27.5 C100 27.5, 92 32, 80 36.5 C58 40.5, 38 37.5, 36 30 Z"
            fill="url(#guppy-body-grad-2)"
          />
          <path d="M48 18 C53 9, 66 7, 70 19 Z" fill="rgba(251,146,60,0.8)" />
          <path
            d="M66 33 C61 39, 54 44, 50 41.5 C48 39, 53 33, 66 33 Z"
            fill="rgba(255,255,255,0.75)"
            class="animate-fish-pectoral"
            style="transform-origin: 66px 33px;"
          />
          <circle cx="88" cy="26.5" r="2.0" fill="#051020" />
          <circle cx="88.5" cy="26.0" r="0.6" fill="#ffffff" />
          <defs>
            <linearGradient id="guppy-tail-grad-2" x1="100%" y1="50%" x2="0%" y2="50%">
              <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.98" />
              <stop offset="50%" stop-color="#fb923c" stop-opacity="0.9" />
              <stop offset="85%" stop-color="#facc15" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0.6" />
            </linearGradient>
            <linearGradient id="guppy-body-grad-2" x1="0%" y1="50%" x2="100%" y2="50%">
              <stop offset="0%" stop-color="#e11d48" />
              <stop offset="60%" stop-color="#fda4af" />
              <stop offset="90%" stop-color="#ffe4e6" />
              <stop offset="100%" stop-color="#ffffff" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- 游动孔雀鱼 3（远景小鱼） -->
      <div
        class="hidden sm:block absolute top-[68%] left-[42%] w-12 sm:w-15 text-aqua-200 animate-tank-fish-3 filter blur-[0.6px] opacity-55"
      >
        <svg viewBox="0 0 120 60" class="w-full h-auto overflow-visible" fill="none">
          <g class="animate-fish-tail" style="transform-origin: 36px 30px;">
            <path
              d="M36 30 C20 14, 8 8, 4 16 C1 24, 2 34, 5 40 C9 46, 20 42, 36 30 Z"
              fill="rgba(56,189,248,0.7)"
            />
          </g>
          <path
            d="M36 30 C38 23, 58 18, 80 22 C92 24, 100 28, 100 28 C100 28, 92 32, 80 36 C58 40, 38 37, 36 30 Z"
            fill="rgba(255,255,255,0.8)"
          />
          <circle cx="88" cy="27" r="1.5" fill="#081830" />
        </svg>
      </div>
    </div>

    {/* 主体内容：居中大气 Apple 风格排版 + 纯粹四大功能胶囊 */}
    <div class="relative z-10 max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8 pt-12 sm:pt-28 pb-16 sm:pb-28 text-center">
      
      <!-- 顶部高定徽章 -->
      <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 py-1 sm:px-4 sm:py-1.5 rounded-full bg-white/[0.08] backdrop-blur-xl border border-white/20 text-[10px] sm:text-xs font-medium text-aqua-200 shadow-lg shadow-black/20 mb-4 sm:mb-8 animate-fade-up">
        <Sparkles class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-aqua-300 animate-pulse shrink-0" />
        <span class="tracking-[0.15em] sm:tracking-[0.22em] uppercase font-mono text-[9px] sm:text-[11px]">POECILIA RETICULATA</span>
        <span class="text-white/30">|</span>
        <span class="tracking-wide">纯系孔雀鱼知识库</span>
      </div>

      <!-- 主标题：大气纯正 Typography -->
      <h1 class="text-2xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.2] sm:leading-[1.12] drop-shadow-[0_2px_24px_rgba(56,189,248,0.25)] animate-fade-up">
        走进纯系孔雀鱼的<br />
        <span class="bg-gradient-to-r from-aqua-300 via-sky-200 to-indigo-300 bg-clip-text text-transparent">
          绚丽微观世界
        </span>
      </h1>

      <!-- 四大核心功能高定毛玻璃胶囊（移动端 2x2 对称紧凑网格，桌面端水平排列） -->
      <div class="mt-6 sm:mt-12 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:items-center sm:justify-center sm:gap-4 text-xs sm:text-sm animate-fade-up max-w-sm sm:max-w-none mx-auto">
        <a
          href="/breeds/"
          class="hero-pill group px-3 py-2.5 sm:px-4.5 sm:py-2.5 rounded-2xl sm:rounded-full bg-white/[0.08] hover:bg-white/[0.18] backdrop-blur-xl border border-white/[0.18] hover:border-aqua-400/80 text-white transition-all duration-300 hover:-translate-y-1 active:scale-95 flex items-center justify-between sm:justify-start gap-2 shadow-lg shadow-black/25 hover:shadow-aqua-500/20"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-aqua-500/20 border border-aqua-400/40 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
              <Layers class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-aqua-300" />
            </span>
            <span class="font-semibold tracking-wide text-[11px] sm:text-xs truncate">24 品种图鉴</span>
          </div>
          <ChevronRight class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-white/40 group-hover:text-aqua-300 group-hover:translate-x-0.5 transition-all shrink-0" />
        </a>

        <a
          href="/guide/"
          class="hero-pill group px-3 py-2.5 sm:px-4.5 sm:py-2.5 rounded-2xl sm:rounded-full bg-white/[0.08] hover:bg-white/[0.18] backdrop-blur-xl border border-white/[0.18] hover:border-sky-400/80 text-white transition-all duration-300 hover:-translate-y-1 active:scale-95 flex items-center justify-between sm:justify-start gap-2 shadow-lg shadow-black/25 hover:shadow-sky-500/20"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-sky-500/20 border border-sky-400/40 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
              <Compass class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-sky-300" />
            </span>
            <span class="font-semibold tracking-wide text-[11px] sm:text-xs truncate">新手饲养指南</span>
          </div>
          <ChevronRight class="w-3.5 h-3.5 text-white/40 group-hover:text-sky-300 group-hover:translate-x-0.5 transition-all shrink-0" />
        </a>

        <a
          href="/breeding/"
          class="hero-pill group px-3 py-2.5 sm:px-4.5 sm:py-2.5 rounded-2xl sm:rounded-full bg-white/[0.08] hover:bg-white/[0.18] backdrop-blur-xl border border-white/[0.18] hover:border-rose-400/80 text-white transition-all duration-300 hover:-translate-y-1 active:scale-95 flex items-center justify-between sm:justify-start gap-2 shadow-lg shadow-black/25 hover:shadow-rose-500/20"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-rose-500/20 border border-rose-400/40 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
              <Heart class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-rose-300" />
            </span>
            <span class="font-semibold tracking-wide text-[11px] sm:text-xs truncate">28天繁育指南</span>
          </div>
          <ChevronRight class="w-3.5 h-3.5 text-white/40 group-hover:text-rose-300 group-hover:translate-x-0.5 transition-all shrink-0" />
        </a>

        <a
          href="/disease/"
          class="hero-pill group px-3 py-2.5 sm:px-4.5 sm:py-2.5 rounded-2xl sm:rounded-full bg-white/[0.08] hover:bg-white/[0.18] backdrop-blur-xl border border-white/[0.18] hover:border-emerald-400/80 text-white transition-all duration-300 hover:-translate-y-1 active:scale-95 flex items-center justify-between sm:justify-start gap-2 shadow-lg shadow-black/25 hover:shadow-emerald-500/20"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-emerald-500/20 border border-emerald-400/40 grid place-items-center shrink-0 group-hover:scale-110 transition-transform">
              <Stethoscope class="w-3.5 h-3.5 text-emerald-300" />
            </span>
            <span class="font-semibold tracking-wide text-[11px] sm:text-xs truncate">鱼病对症速查</span>
          </div>
          <ChevronRight class="w-3.5 h-3.5 text-white/40 group-hover:text-emerald-300 group-hover:translate-x-0.5 transition-all shrink-0" />
        </a>
      </div>
    </div>

    {/* ───────────────────────────────────────────── */}
    {/* 物理级多层正弦流动波浪 (Triple Fluid Waves)     */}
    {/* ───────────────────────────────────────────── */}
    <div aria-hidden="true" class="wave-container relative -mb-px w-full overflow-hidden leading-none h-12 sm:h-20 select-none">
      {/* 1. 深水涌浪（后景） */}
      <svg
        class="wave-deep absolute bottom-0 left-0 w-[200%] h-full pointer-events-none"
        viewBox="0 0 2880 80"
        preserveAspectRatio="none"
        fill="none"
      >
        <path
          d="M0 40 C400 15, 800 65, 1200 40 C1600 15, 2000 65, 2400 40 C2800 15, 2880 65, 2880 40 L2880 80 L0 80 Z"
          fill="#eef4fb"
          opacity="0.2"
        />
      </svg>

      {/* 2. 中层过渡浪 */}
      <svg
        class="wave-mid absolute bottom-0 left-0 w-[200%] h-full pointer-events-none"
        viewBox="0 0 2880 80"
        preserveAspectRatio="none"
        fill="none"
      >
        <path
          d="M0 50 C360 25, 720 70, 1080 50 C1440 25, 1800 70, 2160 50 C2520 25, 2880 70, 2880 50 L2880 80 L0 80 Z"
          fill="#eef4fb"
          opacity="0.45"
        />
      </svg>

      {/* 3. 前景主浪 */}
      <svg
        class="wave-front absolute bottom-0 left-0 w-[200%] h-full pointer-events-none"
        viewBox="0 0 2880 80"
        preserveAspectRatio="none"
        fill="none"
      >
        <path
          d="M0 55 C360 75, 720 30, 1080 55 C1440 75, 1800 30, 2160 55 C2520 75, 2880 30, 2880 55 L2880 80 L0 80 Z"
          fill="#eef4fb"
        />
      </svg>
    </div>
  </section>

  {/* ───────────────────────────────────────────── */}
  {/* 2. 热门精选品种画廊 (Digital Art Gallery)     */}
  {/* ───────────────────────────────────────────── */}
  {featured.length > 0 && (
    <section class="max-w-6xl mx-auto px-3.5 sm:px-6 lg:px-8 pt-8 sm:pt-14 pb-10 sm:pb-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 sm:gap-3 mb-4 sm:mb-8 pb-3 sm:pb-4 border-b border-slate-200/80">
        <div>
          <nav aria-label="分类说明" class="text-[11px] sm:text-xs text-slate-400 mb-0.5 sm:mb-1 flex items-center gap-1.5">
            <span class="text-aqua-700 font-semibold uppercase tracking-wider">Gallery</span>
            <span class="text-slate-300">/</span>
            <span class="text-slate-600 font-medium">热门推荐</span>
          </nav>
          <h2 class="text-lg sm:text-2xl lg:text-3xl font-extrabold tracking-tight text-slate-900">
            精选经典纯系品种
          </h2>
          <p class="mt-0.5 sm:mt-1 text-xs sm:text-sm text-slate-500">
            收录国际主流品系代表作，悬停/触控即刻查阅档案
          </p>
        </div>

        <a
          href="/breeds/"
          class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-aqua-700 hover:text-aqua-800 transition-colors shrink-0 pt-1 sm:pt-0"
        >
          <span>查看全部 {breeds.length} 个品种</span>
          <ArrowRight class="w-3.5 h-3.5 sm:w-4 sm:h-4 group-hover:translate-x-1 transition-transform duration-200" />
        </a>
      </div>

      {/* 4 列高密度画廊卡片网格（移动端两列，电脑端四列） */}
      <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-4.5">
        {featured.map((breed) => {
          const cover = breed.data.image;
          const grad = COLOR_GRADIENTS[breed.data.color] || '#35a4ff';
          const glow = COLOR_GLOWS[breed.data.color] || 'rgba(53, 164, 255, 0.2)';
          const diff = DIFFICULTY_CONFIG[breed.data.difficulty];

          return (
            <article
              style={`--card-glow: ${glow};`}
              class="gallery-card group relative bg-slate-900 rounded-xl sm:rounded-2xl border border-slate-200/90 overflow-hidden shadow-2xs aspect-[4/3] flex flex-col justify-end"
            >
              <a href={`/breed/${breed.id}/`} class="absolute inset-0 z-0 flex flex-col justify-end">
                {/* 背景鱼照 */}
                <div class="absolute inset-0 w-full h-full overflow-hidden bg-slate-100">
                  <div class="w-full h-full transform transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-105">
                    <BreedImage
                      alt={breed.data.title}
                      image={cover}
                      gradientFrom={grad}
                      width={480}
                      height={360}
                      quality={80}
                    />
                  </div>
                </div>

                {/* 1. 常态展示：底部半透明渐变条 */}
                <div class="relative z-10 w-full p-2 sm:p-3 bg-gradient-to-t from-slate-950/85 via-slate-950/40 to-transparent flex items-end justify-between gap-1 transition-all duration-300 ease-[var(--ease-out-expo)] group-hover:opacity-0 group-hover:translate-y-2">
                  <div class="min-w-0">
                    <h3 class="text-[11px] sm:text-sm font-bold text-white leading-tight truncate drop-shadow-sm">
                      {breed.data.title}
                    </h3>
                    {breed.data.enName && (
                      <p class="text-[8px] sm:text-[10px] text-slate-300 font-serif italic truncate mt-0.5 opacity-90">
                        {breed.data.enName}
                      </p>
                    )}
                  </div>

                  <div class="flex items-center gap-1 shrink-0">
                    <span
                      class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full ring-1 ring-white/30 shadow-xs"
                      style={`background: ${grad}`}
                      aria-hidden="true"
                    ></span>
